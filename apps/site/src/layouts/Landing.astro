---
// The landing, in either language. The brain fills two placeholders when it serves the page
// (brain/public.ts): __CONTACT__ (BRAIN_CONTACT) and __OPERATOR__ (BRAIN_OPERATOR), so nothing about
// one person is written in the repository.
import "../styles/fonts.css";
import "../styles/site.css";
import mark from "../assets/mark.svg?raw";
import Orbit from "../components/Orbit.astro";
import Icon from "../components/Icon.astro";
import { dict, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict[lang];
const home = lang === "en" ? "/" : "/it/";
const origin = Astro.site!.origin;
const url = origin + home;
const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Agents Multi",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  description: t.description,
  inLanguage: lang,
  url,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{t.htmlTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/source-serif-4.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={origin + "/"} />
    <link rel="alternate" hreflang="it" href={origin + "/it/"} />
    <link rel="alternate" hreflang="x-default" href={origin + "/"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agents Multi" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "it_IT"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "it_IT" : "en_US"} />
    <meta property="og:title" content={t.htmlTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={origin + "/og.jpg"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={origin + "/og.jpg"} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href={home}><span class="mark" set:html={mark} />Agents Multi</a>
        <nav class="links">
          <a href="#features">{t.nav.features}</a>
          <a href="#brain">{t.nav.brain}</a>
          <a href="#how">{t.nav.how}</a>
          <a href="/docs/">{t.nav.docs}</a>
        </nav>
        <div class="lang">
          <a href="/" hreflang="en" lang="en" aria-current={lang === "en" ? "page" : undefined}>EN</a>
          <a href="/it/" hreflang="it" lang="it" aria-current={lang === "it" ? "page" : undefined}>IT</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <span class="pill"><b>{t.pill[0]}</b>{t.pill[1]}</span>
          <h1 set:html={t.h1} />
          <p class="lead">{t.lead}</p>
          <div class="ctas">
            <a class="btn" href="/docs/getting-started/#download">{t.ctaDownload}</a>
            <a class="btn ghost" href="mailto:__CONTACT__">{t.ctaContact}</a>
            <a class="btn ghost" href="#how">{t.ctaHow} →</a>
          </div>
          <p class="meta">{t.meta}</p>
          <div class="stage">
            <div class="window">
              <div class="titlebar"><i></i><i></i><i></i><span>127.0.0.1:7331</span></div>
              <img class="shot" src="/console.webp" width="2880" height="1800" alt={t.shotAlt} />
            </div>
            <div class="float term" aria-hidden="true">
              <div><span class="pr">$</span> agents doctor</div>
              <div><span class="ok">✓</span> console on 127.0.0.1:7331</div>
              <div><span class="ok">✓</span> secret vault: every secret here</div>
              <div><span class="ok">✓</span> brain takes this machine's token</div>
              <div class="dim">44 pass · 0 fail</div>
            </div>
          </div>
          <p class="demo">{t.demo}</p>
        </div>
      </section>

      <section class="strip">
        <div class="wrap">
          <p>{t.strip}</p>
          <ul>{t.surfaces.map((s) => <li>{s}</li>)}</ul>
        </div>
      </section>

      <section class="block" id="features">
        <div class="wrap">
          <div class="kicker">{t.featuresKicker}</div>
          <h2>{t.featuresTitle}</h2>
          <p class="intro">{t.featuresIntro}</p>
          <div class="grid">
            {t.features.map(([icon, title, text]) => (
              <article class="card reveal">
                <div class="ic"><Icon name={icon} /></div>
                <h3>{title}</h3>
                <p>{text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="block">
        <div class="wrap">
          <div class="kicker">{t.forKicker}</div>
          <h2>{t.forTitle}</h2>
          <div class="principles">
            {t.forWho.map(([h, p]) => <div class="reveal"><h3>{h}</h3><p>{p}</p></div>)}
          </div>
        </div>
      </section>

      <section class="block alt" id="brain">
        <div class="wrap split">
          <div>
            <div class="kicker">{t.brainKicker}</div>
            <h2>{t.brainTitle}</h2>
            <p class="intro">{t.brainIntro}</p>
            <ul class="points">
              {t.brainPoints.map(([b, text]) => <li class="reveal"><span class="tick">✓</span><span><b>{b}</b>{text}</span></li>)}
            </ul>
          </div>
          <Orbit t={t} />
        </div>
      </section>

      <section class="block" id="how">
        <div class="wrap">
          <div class="kicker">{t.howKicker}</div>
          <h2>{t.howTitle}</h2>
          <div class="steps">
            <ol>{t.steps.map(([b, text]) => <li class="reveal"><span><b>{b}</b><span set:html={text} /></span></li>)}</ol>
            <div class="terminal reveal">
              <div class="titlebar"><i></i><i></i><i></i><span>~</span></div>
              <pre data-type><span class="c"># 1 · the app, from the releases</span>
<span class="pr">$</span> chmod +x agents-multi_amd64.AppImage
<span class="pr">$</span> ./agents-multi_amd64.AppImage
<span class="c"># 2 · the wizard: you, your folder, profiles, install</span>
<span class="c"># 3 · sign in to each profile, then check</span>
<span class="pr">$</span> agents doctor
  <span class="ok">✓</span> profiles: personal, work, research
  <span class="ok">✓</span> console on http://127.0.0.1:7331
  <span class="ok">✓</span> secret vault: 6 accounts, every secret here
  <span class="w">!</span> MCP registry out of sync
      fix: agents mcp sync
  <span class="ok">36 pass</span> · 1 warn · 0 fail</pre>
            </div>
          </div>
        </div>
      </section>

      <section class="block">
        <div class="wrap">
          <div class="kicker">{t.principlesKicker}</div>
          <h2>{t.principlesTitle}</h2>
          <div class="principles">
            {t.principles.map(([h, p]) => <div class="reveal"><h3>{h}</h3><p>{p}</p></div>)}
          </div>
        </div>
      </section>

      <section class="call">
        <div class="wrap">
          <div class="box reveal">
            <h2 set:html={t.callTitle} />
            <p>{t.callText}</p>
            <div class="ctas">
              <a class="btn" href="mailto:__CONTACT__">{t.callContact}</a>
              <a class="btn ghost" href="/docs/">{t.callDocs} →</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <a class="brand" href={home}><span class="mark" set:html={mark} />Agents Multi</a>
        <span>{t.footer.made} __OPERATOR__</span>
        <nav>
          <a href="/docs/">{t.footer.docs}</a>
          <a href="__APP__/privacy">{t.footer.privacy}</a>
          <a href="__APP__/tasks" rel="nofollow">{t.footer.signin}</a>
        </nav>
        <p class="legal">{t.footer.license} {t.footer.legal}</p>
      </div>
    </footer>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
