{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Multi",
  "version": "../package.json",
  "identifier": "net.local.agents-multi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src http://127.0.0.1:*; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "icon": [
      "../../../desktop/icons/32x32/claude-multi.png",
      "../../../desktop/icons/128x128/claude-multi.png",
      "../../../desktop/icons/256x256/claude-multi.png",
      "../../../desktop/icons/512x512/claude-multi.png"
    ]
  }
}
