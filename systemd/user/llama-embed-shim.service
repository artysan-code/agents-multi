[Unit]
Description=Shim API Ollama -> llama-server (per l'MCP wiki-claude)
Documentation=file://%h/.claude-multi/shared/tools/llama-embed-shim/server.ts
# obsidian-brain parla solo ollama o transformers: questo shim traduce.
Requires=llama-embed.service
After=llama-embed.service

[Service]
Type=exec
Environment=LLAMA_BASE_URL=http://127.0.0.1:8090
Environment=SHIM_PORT=11434
Environment=SHIM_MODEL=bge-m3
Environment=GEN_BASE_URL=http://127.0.0.1:8080
Environment=GEN_UNIT=llama-generate.service
# Spegne il server di generazione dopo 5 min di inattività: libera la VRAM.
Environment=GEN_IDLE_SEC=300
# Per machine (~/.config/claude-multi/llama.env): GEN_UNIT= (empty) turns generation off where no
# generation model fits — /api/generate then answers 503 instead of starting one.
EnvironmentFile=-%h/.config/claude-multi/llama.env
ExecStart=%h/.deno/bin/deno run --allow-net --allow-env --allow-run=systemctl %h/.local/src/claude-multi/shared/tools/llama-embed-shim/server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
