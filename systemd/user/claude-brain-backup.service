[Unit]
Description=A copy of the brain on this machine, when it changed (agents brain-backup)
Documentation=file://%h/.local/src/agents-multi/apps/brain/README.md
After=network-online.target

[Service]
Type=oneshot
# the systemd --user session reads no login shell: deno is not on the default PATH
Environment=PATH=%h/.deno/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude-multi brain-backup
Nice=10
