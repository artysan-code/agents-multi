[Unit]
Description=claude-multi desktop app — tray icon and console window
Documentation=file:%h/.local/src/claude-multi/README.md
# A tray icon needs the graphical session; the console it shows is its own unit and is not tied to it.
PartOf=graphical-session.target
After=graphical-session.target claude-multi-console.service

[Service]
Type=simple
Environment=PATH=%h/.deno/bin:%h/.local/bin:%h/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
# --tray: no window at login. Without a system tray it waits a minute, then exits cleanly (0) and
# the doctor says why; on-failure then does not restart it in a loop.
ExecStart=%h/.local/bin/claude-multi-app --tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
