[Unit]
Description=Periodic Claude update check (every 4h)

[Timer]
# 10 min after login: does not slow the session start, and covers the "Claude stays open for days"
# case that a launch-time gate would never see on its own.
OnStartupSec=10min
OnUnitActiveSec=4h
# NB: no Persistent= — it only affects OnCalendar= timers, not monotonic ones like this. Recovery
# is implicit here: the count restarts from OnStartupSec at login.
AccuracySec=1min

[Install]
WantedBy=timers.target
