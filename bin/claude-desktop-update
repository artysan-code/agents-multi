#!/usr/bin/env bash
# claude-desktop-update — Claude Desktop in user space, from Anthropic's signed apt repository.
# No root at any step: nothing is installed under /usr.
#
# Layout (CLAUDE_DESKTOP_ROOT, default ~/.local/lib/claude-desktop):
#   versions/<ver>/   the .deb's usr/lib/claude-desktop as it ships, plus .icons/ (its hicolor icons)
#   current           → versions/<ver>: what the launchers run
#
# A new version is STAGED (downloaded, verified, extracted) whenever the timer finds one, and
# APPLIED (current flipped, profile variants rebuilt, icons installed) only while no Claude Desktop
# runs: replacing files under a running Electron app crashes it. claude-launch applies a staged
# version right before it starts the app, so in practice an update lands at the next launch.
#
# Verification is not optional: the InRelease file must carry a valid signature from the pinned
# key (pkg/claude-desktop/anthropic-apt.asc, fingerprint below), the Packages index must match its
# hash in InRelease, and the .deb must match its hash in Packages. Anything missing or different
# stops the update before a single file is extracted, and says so (exit 4).
#
# usage:
#   claude-desktop-update              stage the latest version if it is newer, then apply it if possible
#   claude-desktop-update --stage      only download, verify and extract
#   claude-desktop-update --apply      only switch to a staged version (no network)
#   claude-desktop-update --rollback   back to the previous version
#   claude-desktop-update --current    print the version in use
#   claude-desktop-update --staged     print the version staged and waiting, if any
# exit: 0 done or nothing to do · 3 another update is running · 4 verification failed
#       5 staged, waiting for every Claude Desktop to close · 1 anything else
set -uo pipefail

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_DIR="$(cd "$HERE/.." && pwd)"
source "$HERE/lib/profiles.sh"
source "$HERE/lib/updates.sh"

ROOT="$CM_DESKTOP_ROOT"
APT="${CLAUDE_DESKTOP_APT:-https://downloads.claude.ai/claude-desktop/apt/stable}"
KEY_ASC="$REPO_DIR/pkg/claude-desktop/anthropic-apt.asc"
KEY_FPR="31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE"
CACHE="$HOME/.cache/claude-update"
NET_TIMEOUT="${CLAUDE_UPDATE_TIMEOUT:-20}"
ICONS="$HOME/.local/share/icons"

say() { [[ -n "${QUIET:-}" ]] || echo "$@"; }
err() { echo "claude-desktop-update: $*" >&2; }

# versions newest first, semver names only
versions() {
  local d
  for d in "$ROOT/versions"/*; do
    d=${d##*/}
    if [[ $d =~ ^[0-9]+(\.[0-9]+)+$ ]]; then printf '%s\n' "$d"; fi
  done | sort -rV
}
current() { local c; c="$(readlink -f "$ROOT/current" 2>/dev/null)" && [[ -x "$c/claude-desktop" ]] && basename "$c"; }
newer() { [[ -n "$2" && "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$2" ]]; }
# the newest extracted version above the current one: staged and waiting
staged() {
  local cur top; cur="$(current)"; top="$(versions | head -n1)"
  [[ -n "$top" ]] && { [[ -z "$cur" ]] || newer "$cur" "$top"; } && echo "$top"
}

lock() {
  mkdir -p "$ROOT"
  exec 7>"$ROOT/.lock"
  flock -n 7 || { err "another Desktop update is running"; exit 3; }
}

# --------------------------------------------------------------------------- stage
# Prints "<version> <sha256> <pool path>" of the newest package, from a verified index.
verified_latest() {
  local tmp inr idx keyring gv want have
  command -v gpgv >/dev/null && command -v gpg >/dev/null || { err "gpg/gpgv missing: cannot verify the repository"; return 4; }
  [[ -f "$KEY_ASC" ]] || { err "pinned key missing: $KEY_ASC"; return 4; }
  tmp="$(mktemp -d)"; inr="$tmp/InRelease"; idx="$tmp/Packages"; keyring="$tmp/key.gpg"
  gpg --dearmor < "$KEY_ASC" > "$keyring" 2>/dev/null || { rm -rf "$tmp"; err "cannot read the pinned key"; return 4; }
  curl -fsSL --max-time "$NET_TIMEOUT" "$APT/dists/stable/InRelease" -o "$inr" \
    && curl -fsSL --max-time "$NET_TIMEOUT" "$APT/dists/stable/main/binary-amd64/Packages" -o "$idx" \
    || { rm -rf "$tmp"; err "cannot reach the repository"; return 1; }
  gv="$(gpgv --keyring "$keyring" "$inr" 2>&1)" || { rm -rf "$tmp"; err "InRelease signature is NOT valid"; return 4; }
  grep -q "$KEY_FPR" <<<"$gv" || { rm -rf "$tmp"; err "InRelease signed by a key other than the pinned one"; return 4; }
  want="$(awk '/^SHA256:/{f=1;next} /^[^ ]/{f=0} f && $3=="main/binary-amd64/Packages"{print $1; exit}' "$inr")"
  have="$(sha256sum "$idx" | awk '{print $1}')"
  [[ -n "$want" && "$want" == "$have" ]] || { rm -rf "$tmp"; err "Packages index does not match the signed InRelease"; return 4; }
  awk '/^Package:/{p=$2} /^Version:/{v=$2} /^SHA256:/{s=$2} /^Filename:/{f=$2}
       /^[[:space:]]*$/{if(p=="claude-desktop"&&v)print v, s, f; p=v=s=f=""}
       END{if(p=="claude-desktop"&&v)print v, s, f}' "$idx" | sort -V | tail -n1
  rm -rf "$tmp"
}

do_stage() {
  local line ver sha path cur deb tmp got rc
  line="$(verified_latest)"; rc=$?
  if [[ $rc -ne 0 ]]; then
    [[ $rc -eq 4 ]] && { cm_update_log desktop verify-failed "$(current)" "" "repository verification failed"; cm_notify "Claude Desktop not updated" "The repository failed verification: nothing was installed."; }
    return $rc
  fi
  read -r ver sha path <<<"$line"
  [[ -n "$ver" && -n "$sha" && -n "$path" ]] || { err "cannot parse the package index"; return 1; }
  cur="$(current)"
  if [[ -d "$ROOT/versions/$ver" ]]; then say "Claude Desktop $ver already here"; return 0; fi
  if [[ -n "$cur" ]] && ! newer "$cur" "$ver"; then say "Claude Desktop $cur is up to date"; return 0; fi

  mkdir -p "$CACHE/desktop" "$ROOT/versions"
  deb="$CACHE/desktop/claude-desktop_${ver}_amd64.deb"
  if [[ ! -f "$deb" ]] || [[ "$(sha256sum "$deb" | awk '{print $1}')" != "$sha" ]]; then
    say "downloading Claude Desktop $ver"
    curl -fsSL --max-time 900 "$APT/$path" -o "$deb.part" || { rm -f "$deb.part"; err "download failed"; cm_update_log desktop failed "$cur" "$ver" "download failed"; return 1; }
    mv -f "$deb.part" "$deb"
  fi
  got="$(sha256sum "$deb" | awk '{print $1}')"
  if [[ "$got" != "$sha" ]]; then
    rm -f "$deb"
    err "the downloaded package does not match the signed index"
    cm_update_log desktop verify-failed "$cur" "$ver" "package hash mismatch"
    cm_notify "Claude Desktop not updated" "Version $ver failed verification: nothing was installed."
    return 4
  fi

  # extract: the application directory and the icons, nothing else from the package
  tmp="$ROOT/versions/.$ver.tmp"; rm -rf "$tmp"; mkdir -p "$tmp"
  local data; data="$(ar t "$deb" | grep '^data\.tar' | head -n1)"
  if [[ -z "$data" ]] || ! ar p "$deb" "$data" | bsdtar -xf - -C "$tmp" ./usr/lib/claude-desktop ./usr/share/icons 2>/dev/null \
    || [[ ! -x "$tmp/usr/lib/claude-desktop/claude-desktop" ]]; then
    rm -rf "$tmp"; err "cannot extract $deb"; cm_update_log desktop failed "$cur" "$ver" "extraction failed"; return 1
  fi
  mv "$tmp/usr/lib/claude-desktop" "$ROOT/versions/.$ver.app"
  [[ -d "$tmp/usr/share/icons" ]] && mv "$tmp/usr/share/icons" "$ROOT/versions/.$ver.app/.icons"
  rm -rf "$tmp"
  mv -T "$ROOT/versions/.$ver.app" "$ROOT/versions/$ver"
  # only the newest package stays in the cache: the extracted versions are the rollback
  find "$CACHE/desktop" -name 'claude-desktop_*_amd64.deb' ! -name "claude-desktop_${ver}_amd64.deb" -delete 2>/dev/null
  cm_update_log desktop staged "$cur" "$ver" ""
  say "Claude Desktop $ver staged"
}

# --------------------------------------------------------------------------- apply
# The profiles that run a variant of their own (a distinct app_id): each is rebuilt against the
# new version. CLAUDE_DESKTOP_VARIANTS overrides the list (tests: empty).
variant_profiles() {
  if [[ -n "${CLAUDE_DESKTOP_VARIANTS+x}" ]]; then tr ' ' '\n' <<<"$CLAUDE_DESKTOP_VARIANTS" | grep -v '^$'; return; fi
  local p; while read -r p; do [[ -n "$p" && -n "$(cm_desktop_appid "$p")" ]] && echo "$p"; done < <(cm_profiles)
}

switch_to() {  # <version> <event>
  local ver="$1" event="$2" from p failed=()
  from="$(current)"
  ln -sfn "versions/$ver" "$ROOT/.current.tmp" && mv -T "$ROOT/.current.tmp" "$ROOT/current" \
    || { err "cannot switch to $ver"; cm_update_log desktop failed "$from" "$ver" "switch failed"; return 1; }
  if [[ -d "$ROOT/versions/$ver/.icons" ]]; then
    mkdir -p "$ICONS" && cp -rf "$ROOT/versions/$ver/.icons/." "$ICONS/"
  fi
  while read -r p; do
    [[ -z "$p" ]] && continue
    QUIET=1 "$HERE/claude-desktop-rebuild" "$p" >/dev/null 2>&1 || failed+=("$p")
  done < <(variant_profiles)
  # keep the version in use and the one before it (the rollback); the rest goes
  local keep_prev v; keep_prev="$(versions | grep -vx "$ver" | head -n1)"
  [[ "$event" == rollback ]] && keep_prev="$from"
  while read -r v; do
    [[ -z "$v" || "$v" == "$ver" || "$v" == "$keep_prev" ]] && continue
    newer "$ver" "$v" && continue   # a newer staged version is never pruned
    rm -rf -- "${ROOT:?}/versions/$v"
  done < <(versions)
  if (( ${#failed[@]} )); then
    cm_update_log desktop failed "$from" "$ver" "variant rebuild failed: ${failed[*]}"
    err "switched to $ver, but the variant for ${failed[*]} failed to rebuild (claude-desktop-rebuild <profile>)"
    return 1
  fi
  cm_update_log desktop "$event" "$from" "$ver" ""
  if [[ -n "$from" ]]; then say "Claude Desktop $from → $ver"; else say "Claude Desktop $ver in use"; fi
}

do_apply() {
  local ver; ver="$(staged)" || true
  [[ -n "$ver" ]] || return 0
  if cm_desktop_running; then say "Claude Desktop $ver is ready: it switches when every Claude Desktop is closed"; return 5; fi
  switch_to "$ver" applied
}

do_rollback() {
  local cur prev; cur="$(current)"
  prev="$(versions | while read -r v; do [[ -n "$cur" ]] && newer "$v" "$cur" && { echo "$v"; break; }; done)"
  [[ -n "$prev" ]] || { err "no previous version to go back to"; return 1; }
  if cm_desktop_running; then err "close every Claude Desktop first"; return 5; fi
  switch_to "$prev" rollback
}

case "${1:-}" in
  --current) current; exit 0 ;;
  --staged) staged; exit 0 ;;
  --stage) lock; do_stage; exit $? ;;
  --apply) lock; do_apply; exit $? ;;
  --rollback) lock; do_rollback; exit $? ;;
  "") lock; do_stage || exit $?; do_apply; exit $? ;;
  -h | --help) sed -n '2,27p' "$0"; exit 0 ;;
  *) err "unknown option $1"; exit 2 ;;
esac
