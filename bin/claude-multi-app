#!/usr/bin/env bash
# claude-multi-app: the desktop app (tray and console window) — apps/tray/.
# /usr/bin/python3 and not `python3`: PySide6 is a system package, and a pyenv, conda or venv
# python first in PATH would not have it.
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
exec /usr/bin/python3 "$HERE/../apps/tray/app.py" "$@"
