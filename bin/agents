#!/usr/bin/env bash
# agents: setup management CLI (also answers to agents-multi and claude-multi) (install, doctor, status, sync, update).
# The logic lives in apps/cli/main.ts (Deno); this shim resolves the repo from its own real path and
# runs it with a minimal permission set.
# Network allowed: Google (calendar and mail), the brain host (the `brain` account in accounts.json,
# in the person's config) for tasks, loopback, the claude-multi-app unix socket, and the desktop app's
# (its updates: apps/cli/console/app-update.ts; the app names it for the backend it starts).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
source "$HERE/lib/profiles.sh"
# The desktop app's backend hands its bundled Deno to the commands the console runs (docs/adr/0003);
# in app mode a terminal finds the same one through the runtime's link (apps/cli/appcopy.ts).
DENO="${AGENTS_MULTI_DENO:-}"
if [[ -z "$DENO" && "$(cm_mode)" == app && -x "$(cm_runtime)/bin/deno" ]]; then DENO="$(cm_runtime)/bin/deno"; fi
DENO="${DENO:-deno}"
command -v "$DENO" >/dev/null 2>&1 || { echo "agents: deno is required (https://deno.land)" >&2; exit 1; }
# Brain host(s), taken from the `brain` accounts of accounts.json.
ACCOUNTS="${AGENTS_MULTI_ACCOUNTS:-${CLAUDE_MULTI_ACCOUNTS:-$(cm_config)/accounts.json}}"
BRAIN_HOSTS=$(python3 - "$ACCOUNTS" 2>/dev/null <<'PY' || true
import json, sys, urllib.parse
try:
    accounts = json.load(open(sys.argv[1])).get("accounts", [])
except (OSError, ValueError):
    accounts = []
print(",".join(sorted({urllib.parse.urlparse(a["url"]).netloc for a in accounts if a.get("service") == "brain" and a.get("url")})))
PY
)
exec "$DENO" run --quiet --allow-read --allow-write --allow-run --allow-env --allow-sys=hostname --allow-net=127.0.0.1,oauth2.googleapis.com,www.googleapis.com${BRAIN_HOSTS:+,$BRAIN_HOSTS},"unix:${XDG_RUNTIME_DIR:-/tmp}/claude-multi-app.sock,unix:${AGENTS_MULTI_APP_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/agents-multi-app.sock}" \
  "$REPO/apps/cli/main.ts" "$@"
