#!/usr/bin/env bash
# claude-launch: avvia Claude Desktop per un profilo qualsiasi, passando prima dal gate
# di aggiornamento grafico. È lo script puntato dagli Exec= dei .desktop.
#
# USO:
#   claude-launch <profilo> [args...]  # i profili sono quelli di profiles/*/profile.json
#   claude-launch --check-only         # diagnostica: dice cosa farebbe, non apre nulla
#
# Quale eseguibile parte lo dice il manifest, non un ramo scritto qui: il profilo la cui
# user-data-dir è ~/.config/Claude usa il `claude-desktop` di sistema, ogni altro ha una build
# con app_id distinto (bin/claude-desktop-rebuild), perché il binario ufficiale si auto-assegna
# l'app_id e KDE darebbe la stessa icona a tutti.
#
# COSA FA, IN ORDINE:
#   1. legge lo stato versioni (cache TTL, così l'apertura non paga la rete a ogni click)
#   2. se Claude Desktop O Claude Code è obsoleto → mostra claude-update-gui PRIMA di aprire
#      l'app, dove SCEGLI cosa aggiornare: niente parte senza spunta. Il gate sta prima perché
#      l'install di Desktop sostituisce /usr/lib/claude-desktop, e ad app aperta la fa crashare
#   3. exec dell'app, sempre — qualunque cosa vada storta sopra, Claude si apre
#
# Il gate non compare più per le versioni messe da parte con "Salta queste versioni"
# (~/.config/claude-update/skipped) e non compare affatto se il check fallisce (offline).
# Fuori dall'avvio ci pensa il timer claude-update-check.timer → claude-update-notify.
set -uo pipefail

BIN="$HOME/.local/bin"
CACHE_DIR="$HOME/.cache/claude-update"
CACHE="$CACHE_DIR/check.json"
SKIP_FILE="$HOME/.config/claude-update/skipped"
GUI="${CLAUDE_UPDATE_GUI:-$BIN/claude-update-gui}"   # override per test (o per sostituire il gate)
TTL="${CLAUDE_LAUNCH_TTL:-21600}"        # 6h: oltre, si ricontrolla
# Due budget annidati, e il primo DEVE stare dentro il secondo: claude-update fa due fetch
# indipendenti (canale CLI + indice apt), ognuno con il suo timeout. Con 8s di default per
# fetch il worst case è 16s: un `timeout 10` esterno li ammazzerebbe a metà e lo stato
# tornerebbe vuoto anche con la rete a posto.
FETCH_TIMEOUT="${CLAUDE_LAUNCH_FETCH_TIMEOUT:-4}"   # per singolo fetch
CHECK_TIMEOUT="${CLAUDE_LAUNCH_CHECK_TIMEOUT:-12}"  # cintura sull'intero check

# Repo claude-multi: allinea la config PRIMA che parta l'app (fetch se stantio, pull ff-only,
# mai bloccante). Stessa logica dei wrapper di lancio della CLI.
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
bash "$HERE/lib/prelaunch.sh" || true
source "$HERE/lib/profiles.sh"

known="$(cm_profiles | tr '\n' '|')"; known="${known%|}"
default_profile="$(cm_profile_for claude)"; default_profile="${default_profile:-$(cm_profiles | head -n1)}"
profile="${1:-}"; [[ $# -gt 0 ]] && shift
check_only=0
[[ "$profile" == "--check-only" ]] && { check_only=1; profile="$default_profile"; }
# ...oppure dopo il nome del profilo, per poter diagnosticare una variante senza aprirla.
[[ "${1:-}" == "--check-only" ]] && { check_only=1; shift; }
if [[ -z "$profile" ]] || ! cm_has_profile "$profile"; then
  echo "Uso: claude-launch <$known> [args...]" >&2; exit 2
fi

# --- lancio dell'app --------------------------------------------------------
# Una sola strada per tutti i profili: config dir e user-data-dir dal manifest, eseguibile scelto
# dalla presenza di un app_id dedicato.
launch() {
  local appid data_dir
  appid="$(cm_desktop_appid "$profile")"
  data_dir="$(cm_desktop_dir "$profile")"
  if [[ -n "$appid" ]]; then
    exec env CLAUDE_CONFIG_DIR="$HOME/.claude-multi/$profile" \
      "$HOME/.local/lib/$appid/$appid" \
      --ozone-platform=wayland --user-data-dir="$data_dir" "$@"
  else
    exec env CLAUDE_CONFIG_DIR="$HOME/.claude-multi/$profile" claude-desktop "$@"
  fi
}
if [[ $check_only -eq 1 ]]; then
  # Diagnostica: stessa strada, ma invece di exec-are l'app si ferma e lo dichiara.
  launch() {
    local appid; appid="$(cm_desktop_appid "$profile")"
    echo "(check-only) profilo '$profile'"
    if [[ -n "$appid" ]]; then echo "  eseguibile:     $HOME/.local/lib/$appid/$appid"
    else echo "  eseguibile:     claude-desktop (di sistema)"; fi
    echo "  user-data-dir:  $(cm_desktop_dir "$profile")"
    echo "  CLAUDE_CONFIG_DIR: $HOME/.claude-multi/$profile"
    exit 0
  }
fi

# --- stato versioni, con cache ----------------------------------------------
mkdir -p "$CACHE_DIR"
state=""
if [[ -f "$CACHE" ]]; then
  age=$(( $(date +%s) - $(stat -c %Y "$CACHE" 2>/dev/null || echo 0) ))
  [[ $age -lt $TTL ]] && state="$(cat "$CACHE" 2>/dev/null)"
fi

if [[ -z "$state" ]]; then
  # `timeout` è la cintura di sicurezza: anche con DNS che pende, l'app si apre comunque.
  state="$(CLAUDE_UPDATE_TIMEOUT="$FETCH_TIMEOUT" timeout "$CHECK_TIMEOUT" \
           "$BIN/claude-update" --check --json 2>/dev/null)"
  [[ -n "$state" ]] && printf '%s\n' "$state" > "$CACHE"
fi
[[ -n "$state" ]] || launch "$@"   # nessuno stato (offline/timeout) → apri e basta

# Estrazione senza jq (non è tra le dipendenze del setup): campi piatti, regex sufficiente.
field() { printf '%s' "$state" | grep -o "\"$1\":{[^}]*}" | grep -o "\"$2\":\"\?[^,\"}]*" | cut -d: -f2 | tr -d '"'; }
desk_outdated="$(field desktop outdated)"
desk_latest="$(field desktop latest)"
cli_outdated="$(field cli outdated)"
cli_latest="$(field cli latest)"

# skipped? → quel componente non conta come obsoleto ai fini del gate
skipped() { [[ -f "$SKIP_FILE" ]] && grep -qxF "$1 $2" "$SKIP_FILE"; }
skipped desktop "$desk_latest" && desk_outdated=false
skipped cli     "$cli_latest"  && cli_outdated=false

# --- 1) gate GUI: scegli tu cosa aggiornare (bloccante, prima del launch) ----
if [[ "$desk_outdated" == "true" || "$cli_outdated" == "true" ]] && [[ -x "$GUI" ]]; then
  "$GUI" --profile "$profile" --state "$state"
  case $? in
    0|20) rm -f "$CACHE" ;;   # aggiornato o messo da parte: la cache è da rifare
  esac
fi

# --- 2) l'app parte comunque ------------------------------------------------
launch "$@"
