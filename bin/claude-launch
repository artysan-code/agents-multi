#!/usr/bin/env bash
# claude-launch: avvia Claude Desktop per un profilo qualsiasi. È lo script puntato dagli Exec= dei
# .desktop.
#
# USO:
#   claude-launch <profilo> [args...]  # i profili sono quelli di profiles/*/profile.json
#   claude-launch --check-only         # diagnostica: dice cosa farebbe, non apre nulla
#
# Quale eseguibile parte lo dice il manifest, non un ramo scritto qui: il profilo la cui
# user-data-dir è ~/.config/Claude usa il Claude Desktop di serie (~/.local/lib/claude-desktop/current),
# ogni altro ha una build con app_id distinto (bin/claude-desktop-rebuild), perché il binario
# ufficiale si auto-assegna l'app_id e KDE darebbe la stessa icona a tutti.
#
# Aggiornamenti: nessuna domanda. Il timer scarica e verifica le versioni nuove in background; qui,
# prima di aprire l'app, una versione già pronta entra in uso se nessun Claude Desktop è aperto
# (claude-desktop-update --apply: è il momento in cui sostituirla non fa crashare niente). Se
# qualcosa va storto, l'app si apre comunque sulla versione di prima.
set -uo pipefail

DESKTOP="${CLAUDE_DESKTOP_ROOT:-$HOME/.local/lib/claude-desktop}/current/claude-desktop"

# Repo claude-multi: allinea la config PRIMA che parta l'app (fetch se stantio, pull ff-only,
# mai bloccante). Stessa logica dei wrapper di lancio della CLI.
HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
bash "$HERE/lib/prelaunch.sh" || true
source "$HERE/lib/profiles.sh"

known="$(cm_profiles | tr '\n' '|')"; known="${known%|}"
default_profile="$(cm_profile_for claude)"; default_profile="${default_profile:-$(cm_profiles | head -n1)}"
profile="${1:-}"; [[ $# -gt 0 ]] && shift
check_only=0
[[ "$profile" == "--check-only" ]] && { check_only=1; profile="$default_profile"; }
# ...oppure dopo il nome del profilo, per poter diagnosticare una variante senza aprirla.
[[ "${1:-}" == "--check-only" ]] && { check_only=1; shift; }
if [[ -z "$profile" ]] || ! cm_has_profile "$profile"; then
  echo "Uso: claude-launch <$known> [args...]" >&2; exit 2
fi

# --- lancio dell'app --------------------------------------------------------
# Una sola strada per tutti i profili: config dir e user-data-dir dal manifest, eseguibile scelto
# dalla presenza di un app_id dedicato.
# disableAccountMcp: Desktop runs its own bundled Claude Code for the Code tab, not bin/claude, so
# the --settings overlay cannot reach it; the environment does, and this variable switches off the
# claude.ai connectors there. The organisation's synced plugins stay on inside Desktop.
launch() {
  local appid data_dir account_env=()
  appid="$(cm_desktop_appid "$profile")"
  data_dir="$(cm_desktop_dir "$profile")"
  cm_flag "$profile" disableAccountMcp && account_env=(ENABLE_CLAUDEAI_MCP_SERVERS=false)
  if [[ -n "$appid" ]]; then
    exec env CLAUDE_CONFIG_DIR="$HOME/.claude-multi/$profile" "${account_env[@]}" \
      "$HOME/.local/lib/$appid/$appid" \
      --ozone-platform=wayland --user-data-dir="$data_dir" "$@"
  else
    # prima della migrazione a user space c'è solo il pacchetto di sistema
    local bin="$DESKTOP"; [[ -x "$bin" ]] || bin=claude-desktop
    exec env CLAUDE_CONFIG_DIR="$HOME/.claude-multi/$profile" "${account_env[@]}" "$bin" "$@"
  fi
}
if [[ $check_only -eq 1 ]]; then
  # Diagnostica: stessa strada, ma invece di exec-are l'app si ferma e lo dichiara.
  launch() {
    local appid; appid="$(cm_desktop_appid "$profile")"
    echo "(check-only) profilo '$profile'"
    if [[ -n "$appid" ]]; then echo "  eseguibile:     $HOME/.local/lib/$appid/$appid"
    elif [[ -x "$DESKTOP" ]]; then echo "  eseguibile:     $DESKTOP"
    else echo "  eseguibile:     claude-desktop (pacchetto di sistema)"; fi
    local staged; staged="$("$HERE/claude-desktop-update" --staged 2>/dev/null)"
    [[ -n "$staged" ]] && echo "  versione pronta: $staged (entra in uso all'avvio, se nessun Desktop è aperto)"
    echo "  user-data-dir:  $(cm_desktop_dir "$profile")"
    echo "  CLAUDE_CONFIG_DIR: $HOME/.claude-multi/$profile"
    cm_flag "$profile" disableAccountMcp && echo "  ENABLE_CLAUDEAI_MCP_SERVERS=false (disableAccountMcp)"
    exit 0
  }
fi

# --- una versione pronta entra in uso adesso, se si può ------------------------
# Quiet e senza rete: al massimo qualche secondo per ricostruire le varianti. Qualunque esito
# (niente da fare, lock occupato, un altro Desktop aperto, errore), l'app parte lo stesso.
[[ $check_only -eq 1 ]] || QUIET=1 "$HERE/claude-desktop-update" --apply >/dev/null 2>&1 || true

launch "$@"
