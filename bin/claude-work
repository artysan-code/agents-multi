#!/usr/bin/env bash
# claude-work — Claude Code con il profilo WORK (account Agency).
# Per il profilo personal: `claude`. Fa parte del repo claude-multi (bin/).
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROFILE_DIR="$HOME/.claude-multi/work"

if [[ "${1:-}" == "update" ]]; then
  echo "claude-work: l'update passa da 'claude-multi update' (ripristina wrapper e claude-bin)." >&2
  exec "$HERE/claude-multi" update --cli
fi

bash "$HERE/lib/prelaunch.sh" || true

CLAUDE_BIN="$HOME/.local/bin/claude-bin"
if [[ ! -x "$CLAUDE_BIN" ]]; then
  LATEST=$(ls -1v "$HOME/.local/share/claude/versions/" | tail -n1)
  CLAUDE_BIN="$HOME/.local/share/claude/versions/$LATEST"
fi
exec env CLAUDE_CONFIG_DIR="$PROFILE_DIR" DISABLE_AUTOUPDATER=1 "$CLAUDE_BIN" "$@"
