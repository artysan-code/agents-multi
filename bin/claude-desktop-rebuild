#!/usr/bin/env bash
# claude-desktop-rebuild <profilo> — costruisce un eseguibile Claude Desktop dedicato a un profilo,
# con un app_id Wayland DISTINTO (claude-desktop-<profilo>) così KDE gli dà icona e gruppo separati.
#
# Il profilo va dichiarato in profiles/<nome>/profile.json con una desktopDir diversa da
# ~/.config/Claude: è quella a stabilire che serve una build propria (cm_desktop_appid).
#
# PERCHÉ SERVE: il binario ufficiale si auto-assegna l'app_id "claude-desktop" e ignora --class,
# X11 e argv[0] (verificato). L'unico punto che cambia l'app_id è, dentro l'asar, una chiamata
# app.setDesktopName(). Qui:
#   1) estraggo l'app.asar ufficiale
#   2) inietto in testa al main (index.pre.js) app.setDesktopName("claude-desktop-<profilo>") per
#      l'app_id; e sostituisco la sorgente del tooltip della tray nel chunk che lo imposta, che
#      altrimenti mostra "Claude" per ogni profilo
#   3) ripacchettizzo (preservando i native modules *.node)
#   4) assemblo ~/.local/lib/claude-desktop-<profilo>/: binario REALE copiato (necessario perché
#      Electron risolve resources/ dal path reale dell'eseguibile) + resources con l'asar patchato;
#      tutto il resto è SYMLINK alla versione in uso (~/.local/lib/claude-desktop/versions/<ver>,
#      risolta da `current`): una variante resta legata alla sua versione finché non la si ricostruisce
#   5) tingo le due icone della tray col colore dell'icona applicazione del profilo
#
# La supply chain resta pulita: il binario è quello ufficiale Anthropic, l'unica modifica è UNA riga
# nostra e trasparente nell'asar. claude-desktop-update la rilancia a ogni cambio di versione.
set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/profiles.sh"

PROFILE="${1:-}"
if [[ -z "$PROFILE" ]] || ! cm_has_profile "$PROFILE"; then
  echo "Uso: claude-desktop-rebuild <profilo>   (dichiarati: $(cm_profiles | tr '\n' ' '))" >&2
  exit 2
fi
APPID="$(cm_desktop_appid "$PROFILE")"
if [[ -z "$APPID" ]]; then
  echo "ERRORE: il profilo '$PROFILE' usa ~/.config/Claude, cioè il Claude Desktop di serie:" >&2
  echo "        non serve (e non si può fare) una build dedicata. Dagli una desktopDir propria." >&2
  exit 2
fi

SRC="$(readlink -f "${CLAUDE_DESKTOP_ROOT:-$HOME/.local/lib/claude-desktop}/current" 2>/dev/null)"
[[ -n "$SRC" && -x "$SRC/claude-desktop" ]] || { echo "ERRORE: nessun Claude Desktop in uso (claude-desktop-update)" >&2; exit 1; }
DST="$HOME/.local/lib/$APPID"
export PATH="$HOME/.local/share/pnpm/bin:$HOME/.local/share/npm/bin:$PATH"

command -v asar    >/dev/null 2>&1 || { echo "ERRORE: 'asar' assente (pnpm add -g @electron/asar)" >&2; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "ERRORE: python3 assente" >&2; exit 1; }
[ -f "$SRC/resources/app.asar" ] || { echo "ERRORE: $SRC/resources/app.asar non trovato" >&2; exit 1; }

TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT

echo "==> estraggo app.asar ufficiale"
asar extract "$SRC/resources/app.asar" "$TMP/src"

APPNAME="Claude ${PROFILE^}"
echo "==> inietto app_id=$APPID nel main"
python3 - "$TMP/src/.vite/build/index.pre.js" "$APPID" <<'PY'
import sys, re
p, appid = sys.argv[1], sys.argv[2]
s = open(p, encoding='utf-8').read()
MARK = '/*__claude_multi_appid__*/'
# SOLO setDesktopName: da' l'app_id Wayland (icona e raggruppamento nella barra) e non tocca
# nient'altro. NON usare app.setName(): Electron usa il nome dell'app come chiave nel portachiavi
# di sistema, quindi rinominarla rende irraggiungibile il token salvato e l'utente si ritrova a
# rifare il login. Il tooltip della tray si differenzia altrove (vedi patch_tooltip piu' sotto).
inj = MARK + 'try{const a=require("electron").app;a.setDesktopName&&a.setDesktopName("%s");}catch(e){};' % appid
if MARK in s or 'setDesktopName("%s")' % appid in s:
    print("    patch già presente"); sys.exit(0)
# Assert solo su cose STRUTTURALI: il prologo emesso dal minifier è un dettaglio upstream
# volatile (fino al 1.26831 era `"use strict";`, dal 1.26832 il file parte col banner Sentry).
assert s.strip(), "main vuoto: layout dell'asar cambiato?"
assert 'require(' in s[-4000:], "main non sembra CommonJS: verifica il layout dell'asar"
m = re.match(r'''^\s*(?:(["'])use strict\1\s*;?)''', s)
i = m.end() if m else 0
open(p, 'w', encoding='utf-8').write(s[:i] + inj + s[i:])
print("    patch iniettata (offset %d)" % i)
PY

# Il tooltip della tray e' `tray.setToolTip(app.getName())`, e app.getName() NON si tocca: e' la
# chiave con cui Electron trova il token nel portachiavi. Si sostituisce quindi solo l'argomento,
# nel chunk che lo imposta. Best-effort: se il pattern non c'e' piu' (bundle riorganizzato) si
# avvisa e si prosegue — un tooltip generico e' un fastidio, un rebuild fallito no.
echo "==> differenzio il tooltip della tray (\"$APPNAME\")"
python3 - "$TMP/src/.vite/build" "$APPNAME" <<'PY'
import sys, pathlib, re
build, appname = pathlib.Path(sys.argv[1]), sys.argv[2]
lit = '"' + appname.replace('"', '\\"') + '"'
# Due forme nel bundle: setToolTip(X.app.getName()) e setToolTip(e?.tooltip??X.app.getName()).
# Il prefisso opzionale (il default esplicito) si conserva: si sostituisce solo il fallback.
PAT = re.compile(r'(setToolTip\((?:[A-Za-z_$][\w$]*\?\.[\w$]+\?\?)?)[A-Za-z_$][\w$]*\.app\.getName\(\)')
total = 0
for f in sorted(build.glob("*.js")):
    s = f.read_text(encoding="utf-8", errors="surrogateescape")
    if "setToolTip(" not in s:
        continue
    s2, n = PAT.subn(lambda m: m.group(1) + lit, s)
    if n:
        f.write_text(s2, encoding="utf-8", errors="surrogateescape")
        total += n
print(f"    {total} chiamate aggiornate" if total else "    ATTENZIONE: nessun setToolTip(app.getName()) trovato: il tooltip resta generico")
PY

echo "==> ripacchettizzo (native modules *.node unpacked)"
asar pack "$TMP/src" "$TMP/app.asar" --unpack "*.node" >/dev/null

# Post-verify: la patch DEVE essere nel pacchetto finale. Senza questo, un futuro cambio di
# layout dell'asar produrrebbe silenziosamente una variante Work senza app_id distinto
# (stessa icona/gruppo del profilo di default) invece di fallire.
# NB: `asar extract-file` NON scrive su stdout — deposita il file (basename) nella cwd.
mkdir -p "$TMP/verify"
( cd "$TMP/verify" && asar extract-file "$TMP/app.asar" .vite/build/index.pre.js )
head -c 400 "$TMP/verify/index.pre.js" | grep -q '__claude_multi_appid__' \
  || { echo "ERRORE: patch assente nell'asar ripacchettizzato" >&2; exit 1; }
echo "    patch verificata nell'asar"

echo "==> assemblo $DST"
rm -rf "$DST"; mkdir -p "$DST/resources"
# binario reale (rinominato: identifica i processi; l'app_id lo dà comunque setDesktopName)
cp -f "$SRC/claude-desktop" "$DST/$APPID"; chmod +x "$DST/$APPID"
# fratelli del binario: symlink (chromium .pak/.so, locales, version, chrome-sandbox SUID…)
for f in "$SRC"/*; do
  bn="$(basename "$f")"; [ "$bn" = "claude-desktop" ] && continue
  ln -sfn "$f" "$DST/$bn"
done
# resources: asar patchato + unpacked reali, tutto il resto symlink (smol-bin.img, virtiofsd, icone…)
cp -f "$TMP/app.asar" "$DST/resources/app.asar"
cp -a "$TMP/app.asar.unpacked" "$DST/resources/app.asar.unpacked"
for f in "$SRC"/resources/*; do
  bn="$(basename "$f")"; case "$bn" in app.asar|app.asar.unpacked) continue;; esac
  ln -sfn "$f" "$DST/resources/$bn"
done

# --- icona della system tray -------------------------------------------------
# Quella di serie e' monocromatica (bianca su tema scuro, nera su chiaro): con piu' profili aperti
# la tray mostra icone identiche. Qui i due PNG smettono di essere symlink e diventano copie tinte
# col colore dell'icona applicazione di questo profilo, cosi' tray e lanciatore dicono la stessa
# cosa. Se Pillow manca si tiene l'icona di serie: e' un di piu', non un requisito.
REPO_DIR="$(cm_repo)"
HUE_SRC="$REPO_DIR/desktop/icons/256x256/$APPID.png"
if [[ -f "$HUE_SRC" ]]; then
  echo "==> tingo l'icona della tray col colore del profilo"
  for icon in TrayIconLinux.png TrayIconLinux-Dark.png; do
    [[ -e "$SRC/resources/$icon" ]] || continue
    rm -f "$DST/resources/$icon"
    if python3 "$REPO_DIR/shared/tools/tint-tray-icon.py" "$SRC/resources/$icon" "$DST/resources/$icon" "$HUE_SRC" 2>/dev/null; then
      echo "    $icon tinta"
    else
      ln -sfn "$SRC/resources/$icon" "$DST/resources/$icon"
      echo "    $icon: tintura non riuscita, resta quella di serie"
    fi
  done
else
  echo "    nessuna icona applicazione per $APPID: la tray resta monocromatica"
fi

echo "==> fatto: $DST/$APPID (app_id=$APPID, nome=\"$APPNAME\")"
