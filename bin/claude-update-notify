#!/usr/bin/env bash
# claude-update-notify: controlla se ci sono aggiornamenti e, se sì, manda UNA notifica KDE
# con l'azione "Aggiorna ora" che apre il gate grafico. Non aggiorna niente da sé.
#
# Lanciato dal timer `claude-update-check.timer` (vedi ~/.config/systemd/user/).
# A mano: `claude-update-notify` (usa la cache) · `claude-update-notify --force` (ignora cache
# e il registro delle notifiche già mostrate).
#
# Tre regole per non diventare spam:
#   1. le versioni messe da parte nel gate ("Salta queste versioni") non si notificano più
#   2. una coppia di versioni già notificata non si ripete (registro in ~/.cache/claude-update)
#   3. se il check fallisce (offline, timeout) si esce in silenzio: nessuna notifica d'errore
set -uo pipefail

BIN="$HOME/.local/bin"
CACHE_DIR="$HOME/.cache/claude-update"
NOTIFIED="$CACHE_DIR/notified"
SKIP_FILE="$HOME/.config/claude-update/skipped"
FETCH_TIMEOUT="${CLAUDE_NOTIFY_FETCH_TIMEOUT:-8}"
CHECK_TIMEOUT="${CLAUDE_NOTIFY_CHECK_TIMEOUT:-25}"

force=0
[[ "${1:-}" == "--force" ]] && force=1

mkdir -p "$CACHE_DIR"

state="$(CLAUDE_UPDATE_TIMEOUT="$FETCH_TIMEOUT" timeout "$CHECK_TIMEOUT" \
         "$BIN/claude-update" --check --json 2>/dev/null)"
[[ -n "$state" ]] || exit 0          # offline o timeout: silenzio, si riprova al prossimo giro

# La cache del launcher viene aggiornata qui: se poi apri Claude, non ripaga la rete.
printf '%s\n' "$state" > "$CACHE_DIR/check.json"

field() { printf '%s' "$state" | grep -o "\"$1\":{[^}]*}" | grep -o "\"$2\":\"\?[^,\"}]*" | cut -d: -f2 | tr -d '"'; }
desk_out="$(field desktop outdated)"; desk_new="$(field desktop latest)"
cli_out="$(field cli outdated)";      cli_new="$(field cli latest)"

skipped() { [[ -f "$SKIP_FILE" ]] && grep -qxF "$1 $2" "$SKIP_FILE"; }
skipped desktop "$desk_new" && desk_out=false
skipped cli     "$cli_new"  && cli_out=false

[[ "$desk_out" == "true" || "$cli_out" == "true" ]] || exit 0

# Registro anti-ripetizione: la chiave è la coppia di versioni proposte.
key="desktop=${desk_out}:${desk_new} cli=${cli_out}:${cli_new}"
if [[ $force -eq 0 && -f "$NOTIFIED" ]] && grep -qxF "$key" "$NOTIFIED"; then
  exit 0
fi

# Corpo della notifica: dice esattamente cosa c'è, senza promettere azioni automatiche.
body=""
[[ "$desk_out" == "true" ]] && body+="Claude Desktop → $desk_new"
[[ "$desk_out" == "true" && "$cli_out" == "true" ]] && body+=$'\n'
[[ "$cli_out"  == "true" ]] && body+="Claude Code → $cli_new"
body+=$'\n'"Scegli tu cosa aggiornare."

# --wait blocca finché scegli (o finché la notifica scade): il servizio systemd resta attivo,
# ed è voluto — è così che si intercetta il click sull'azione.
choice="$(notify-send --wait \
  -a "Claude" -i claude-desktop -u normal \
  --expire-time=1800000 \
  --action=update="Aggiorna ora" \
  --action=later="Più tardi" \
  "Aggiornamenti Claude disponibili" "$body" 2>/dev/null)"

# Qualunque sia la scelta, questa coppia di versioni è stata mostrata: non si ripropone.
# (Il grep evita righe duplicate quando si rilancia con --force.)
grep -qxF "$key" "$NOTIFIED" 2>/dev/null || printf '%s\n' "$key" >> "$NOTIFIED"

if [[ "$choice" == "update" ]]; then
  # setsid: il gate si stacca da questo servizio systemd. Con `exec` la finestra sarebbe il
  # processo dell'unit e morirebbe al TimeoutStartSec mentre la stai ancora usando.
  # Nessun --state: fra la notifica e il click possono passare ore (expire-time 30 min, più la
  # cronologia di Plasma che la conserva). Il gate rifà il check e mostra le versioni di ADESSO.
  # Se l'app è già nel tray, --updates le passa la richiesta ed esce.
  setsid nohup "${CLAUDE_MULTI_APP:-$BIN/claude-multi-app}" --updates \
    >/dev/null 2>&1 < /dev/null &
fi
exit 0
