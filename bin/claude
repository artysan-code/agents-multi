#!/usr/bin/env bash
# claude — the single launcher for every profile.
#
# It is linked into ~/.local/bin once per profile (`claude`, `claude-alice`, …) and works out which
# profile to start from the name it was invoked as, matched against the `command` field of
# profiles/*/profile.json. Adding a profile therefore adds no file here: `agents install`
# creates the link.
#
# 1. align the config from the repo (prelaunch.sh: fetch when stale, ff-only pull, never blocking)
# 2. pin CLAUDE_CONFIG_DIR to the profile and disable the native auto-updater
# 3. with `disableAccountMcp` in the manifest, pass a --settings overlay that switches off the
#    claude.ai connectors and the organisation's synced plugins
# 4. `<launcher> update` is redirected to `agents update`: the native updater would rewrite
#    ~/.local/bin/claude and leave claude-bin behind
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SELF="$(basename "$0")"

# Which profile answers to this name? The manifest decides; a profile that does not name its
# command answers to claude-<name>, the same default commandOf() applies on the TypeScript side.
source "$HERE/lib/profiles.sh"
PROFILE="$(cm_profile_for "$SELF")"

if [[ -z "$PROFILE" ]]; then
  echo "$SELF: no profile in $(cm_config)/profiles declares this command." >&2
  echo "Add \"command\": \"$SELF\" to a profiles/<name>/profile.json, then run: agents install" >&2
  exit 1
fi

if [[ "${1:-}" == "update" ]]; then
  echo "$SELF: updates go through 'agents update' (it restores the wrappers and claude-bin)." >&2
  exec "$HERE/claude-multi" update --cli
fi

bash "$HERE/lib/prelaunch.sh" || true

CLAUDE_BIN="$HOME/.local/bin/claude-bin"
if [[ ! -x "$CLAUDE_BIN" ]]; then
  LATEST=$(ls -1v "$HOME/.local/share/claude/versions/" | tail -n1)
  CLAUDE_BIN="$HOME/.local/share/claude/versions/$LATEST"
fi
# disableAccountMcp: the generated settings.json already says it (apps/cli/settings.ts); the overlay,
# rebuilt here at every launch, also catches a plugin the organisation synced since the last
# regeneration. A --settings file merges into the settings, enabledPlugins included.
CONFIG_DIR="$HOME/.claude-multi/$PROFILE"
OVERLAY=()
# If the overlay cannot be written, Claude still starts, just without it.
if cm_flag "$PROFILE" disableAccountMcp &&
   cm_account_mcp_settings "$CONFIG_DIR" > "$CONFIG_DIR/account-mcp-off.settings.json" 2>/dev/null; then
  OVERLAY=(--settings "$CONFIG_DIR/account-mcp-off.settings.json")
fi
exec env CLAUDE_CONFIG_DIR="$CONFIG_DIR" DISABLE_AUTOUPDATER=1 "$CLAUDE_BIN" "${OVERLAY[@]}" "$@"
