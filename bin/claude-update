#!/usr/bin/env bash
# claude-update: update orchestrator for the whole multi-account Claude setup.
#
#   [CLI]     Claude Code    - internal updater, then restores claude-bin and the ~/.local/bin/claude wrapper
#   [Desktop] Claude Desktop - claude-desktop-update: verified official .deb, user space, no root
#   [Self]    agents-multi   - the repo itself: fast-forward-only pull on a clean working tree, then
#                              console/app restart if their code changed and install with Claude closed (apps/cli/selfupdate.ts)
#
# Usage:
#   claude-update              # everything: CLI + Desktop + agents-multi
#   claude-update --cli        # Claude Code only
#   claude-update --desktop    # Claude Desktop only (all variants)
#   claude-update --self       # agents-multi only
#   claude-update --auto       # what the timer runs: check and update whatever is behind, silently
#   claude-update --check      # does NOT update: only reports what is outdated (--json for scripts)
#   claude-update --rollback [--desktop]   # back to the previous version (Code, or Desktop)
#
# Every outcome goes to the log (~/.local/state/claude-multi/updates.jsonl, bin/lib/updates.sh).
# The only notification is a failed verification: everything else is read in the console.
#
# The components run ISOLATED: one failing does NOT block the other.
# One row per component (bin/lib/ui.sh), with only the relevant details below; exit != 0 if anything failed.
#
# Note: no top-level `set -e`; failures are handled by hand (subshell + report).
#       Each component has its own `set -e` inside its subshell.
set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/profiles.sh"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/updates.sh"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/ui.sh"

VERSIONS_DIR="$HOME/.local/share/claude/versions"
REPO_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
CM="$REPO_DIR/bin/agents"
BIN_DIR="$HOME/.local/bin"

# Channel used by the native updater: `stable` lags a few releases behind (gradual rollout), while
# `latest` is what `claude update` really installs. Comparing against `stable` would give false
# "update available"/"already up to date" results compared with what then happens.
# (The URLs can be overridden via env, to test an update without waiting for a real release.)
CLI_CHANNEL_URL="${CLAUDE_CLI_CHANNEL_URL:-https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/latest}"
CLI_INSTALLER_URL="${CLAUDE_CLI_INSTALLER_URL:-https://claude.ai/install.sh}"
APT_INDEX_URL="${CLAUDE_APT_INDEX_URL:-https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages}"
NET_TIMEOUT="${CLAUDE_UPDATE_TIMEOUT:-8}"
CACHE_DIR="$HOME/.cache/claude-update"
LOCK_FILE="$CACHE_DIR/update.lock"

# One update at a time (the timer, a launch and a terminal can coincide).
take_lock() {
  mkdir -p "$CACHE_DIR"
  exec 8>"$LOCK_FILE"
  if ! flock -n 8; then
    echo "ERROR: another claude-update is running (lock $LOCK_FILE)" >&2
    exit 3
  fi
}

# semver_dirs <dir>: the X.Y.Z entries of a directory, oldest first.
semver_dirs() {
  local d
  for d in "$1"/*; do
    d=${d##*/}
    if [[ $d =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then printf '%s\n' "$d"; fi
  done | sort -V
}

# Rollback: claude-bin goes back to the previous version still cached (the prune keeps one).
do_rollback() (
  set -e
  local cur prev
  cur="$(basename "$(readlink -f "$BIN_DIR/claude-bin")")"
  prev="$(semver_dirs "$VERSIONS_DIR" | grep -vx "$cur" | tail -n1 || true)"
  [[ -n "$prev" ]] || { echo "ERROR: no previous version in $VERSIONS_DIR (the prune only keeps N-1)" >&2; exit 1; }
  ln -sfn "$VERSIONS_DIR/$prev" "$BIN_DIR/claude-bin"
  cm_update_log cli rollback "$cur" "$prev" ""
  cm_row ok "Claude Code" "$prev" "$(cm_t rolled "$prev")"
  cm_note "$(cm_t forward "$cur")"
)

# --- [CLI] Claude Code ------------------------------------------------------
# The internal updater downloads into ~/.local/share/claude/versions/ and recreates
# ~/.local/bin/claude as a symlink: that bypasses the tripwire and leaves claude-bin (used by the
# profile wrappers) pointing at the old version. Both are put back here.
# Silent: the details to show under the row go in $NOTES (one per line); the native updater's
# output only if it fails.
NOTES="$(mktemp)"; trap 'rm -f -- "$NOTES"' EXIT
note() { printf '%s\n' "$1" >> "$NOTES"; }
show_notes() { local l; while IFS= read -r l; do [[ -n "$l" ]] && cm_note "$l"; done < "$NOTES"; : > "$NOTES"; }

do_cli() (
  set -e
  # The user's shell exports DISABLE_AUTOUPDATER=1 and so do the profile wrappers; in that
  # context the `update` subcommand may be suppressed. The binary is invoked DIRECTLY with that
  # flag stripped, so the explicit update always runs. The binary is shared: updating it once
  # covers every profile.
  local cbin="$BIN_DIR/claude-bin"
  [[ -f "$cbin" && -x "$cbin" ]] || cbin="$VERSIONS_DIR/$(semver_dirs "$VERSIONS_DIR" | tail -n1)"

  # Throwaway CLAUDE_CONFIG_DIR: `update` only downloads the binary and needs no profile state,
  # and writing into a real profile directory would dirty it (a fixed path would also be
  # recreated empty on every update and flagged by doctor as a runtime without a profile).
  local tmpcfg; tmpcfg="$(mktemp -d)"
  trap 'rm -rf -- "$tmpcfg"' EXIT

  # Capture the output to filter the known Warning/Fix block: the native updater warns that
  # ~/.local/bin/claude is not one of its symlinks, but that is the tripwire, which is INTENDED, so
  # it is pure noise. The real exit code is preserved: a genuine failure propagates (do_cli ->
  # FAIL) and is not masked. `|| rc=$?` keeps `set -e` from aborting on the non-zero before it is
  # captured; `|| true` covers the (theoretical) case where grep filters everything out and
  # returns 1 under pipefail.
  #
  # No Claude Code yet (a new machine, the first-run wizard): Anthropic's own installer puts the
  # native build in $VERSIONS_DIR, which is all the rest of this function needs.
  local out rc=0
  if [[ ! -f "$cbin" ]]; then
    note "$(cm_t bootstrap)"
    out="$(curl -fsSL --max-time 60 "$CLI_INSTALLER_URL" |
      env -u DISABLE_AUTOUPDATER CLAUDE_CONFIG_DIR="$tmpcfg" bash 2>&1)" || rc=$?
  else
    out="$(env -u DISABLE_AUTOUPDATER CLAUDE_CONFIG_DIR="$tmpcfg" "$cbin" update 2>&1)" || rc=$?
  fi
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out" | grep -vE '^\s*$|was not created by the native installer|If you put a launcher wrapper there on purpose' | tail -n 4 >> "$NOTES" || true
    exit $rc
  fi

  local latest
  latest="$(semver_dirs "$VERSIONS_DIR" | tail -n1)"
  [[ -n "$latest" ]] || { note "no version in $VERSIONS_DIR"; exit 1; }

  ln -sfn "$VERSIONS_DIR/$latest" "$BIN_DIR/claude-bin"

  # GC of old versions: the native updater DISABLES it because the launcher is custom (the known
  # "keeps them all" warning). Without this, versions/ grows with every update (~275 MB each).
  # The versions are single ELF FILES (`versions/2.1.220`), not directories, so iterate over all
  # entries and filter by semver name: files that do not belong there are never touched.
  # Guard: never the live version ($latest, validated non-empty above and the target of claude-bin).
  # Deleting the ELF of a running session is harmless: the inode stays alive until exit.
  # The second newest (N-1) is kept too, for `agents update --rollback`.
  local v bn prev pruned=()
  prev="$(semver_dirs "$VERSIONS_DIR" | grep -vx "$latest" | tail -n1 || true)"
  for v in "$VERSIONS_DIR"/*; do
    [[ -e "$v" ]] || continue
    bn="$(basename "$v")"
    [[ "$bn" == "$latest" || "$bn" == "$prev" ]] && continue
    [[ "$bn" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    pruned+=("$bn")
    rm -rf -- "$v"
  done
  (( ${#pruned[@]} )) && note "$(cm_t pruned "${pruned[*]}")"
  [[ -n "$prev" && "${CLI_FROM:-}" != "$latest" ]] && note "$(cm_t keep "$prev")"

  # The native updater rewrites ~/.local/bin/claude as a symlink to the new version: restore it
  # to the repo wrapper (the default profile). Other launchers are untouched.
  local repo; repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
  if [[ "$(readlink "$BIN_DIR/claude")" != "$repo/bin/claude" ]]; then
    ln -sfn "$repo/bin/claude" "$BIN_DIR/claude"
    note "$(cm_t wrapper)"
  fi

  # Deep-link handler (claude-cli://): the generated one points to ~/.local/bin/claude, which after
  # the flip is the tripwire, so deep links (login/IDE) would break. Repoint it to claude-bin.
  local handler="$HOME/.local/share/applications/claude-code-url-handler.desktop"
  if [[ -f "$handler" ]] && grep -q -- '--handle-uri' "$handler" && ! grep -qF -- "Exec=\"$BIN_DIR/claude-bin\" --handle-uri" "$handler"; then
    sed -i -E 's#^Exec=.*--handle-uri#Exec="'"$BIN_DIR"'/claude-bin" --handle-uri#' "$handler"
    note "$(cm_t handler)"
  fi
  true
)

# --- [Desktop] Claude Desktop (all variants) ---------------------------------
# claude-desktop-update downloads, verifies and extracts in user space; the new version is put in
# use (with the variants rebuilt) only when no Claude Desktop is running. Exit 5 = staged but
# waiting: not a failure.
do_desktop() {
  QUIET=1 "$BIN_DIR/claude-desktop-update" 2>>"$NOTES" >/dev/null
}

# --- Version check (no writes) ----------------------------------------------
# Cheap and non-blocking: the apt index is ~19 KB, the CLI channel ~10 bytes. Every fetch has a
# timeout; without network the `latest` fields stay empty and `outdated` is false.

# newer A B: true if B is strictly newer than A (semver ordering via sort -V).
# Avoids offering an "update" when the remote channel is behind the local version.
newer() {
  local a="$1" b="$2"
  [[ -n "$b" ]] || return 1
  [[ "$a" == "$b" ]] && return 1
  [[ -z "$a" ]] && return 0
  [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$b" ]]
}

cli_current()  { [[ -e "$BIN_DIR/claude-bin" ]] && basename "$(readlink -f "$BIN_DIR/claude-bin")" || true; }
cli_latest()   { curl -fsSL --max-time "$NET_TIMEOUT" "$CLI_CHANNEL_URL" 2>/dev/null | tr -d '[:space:]'; }
# the version in use in user space; before the migration, the system package's version
desk_current() {
  local v; v="$("$BIN_DIR/claude-desktop-update" --current 2>/dev/null)"
  [[ -n "$v" ]] && { echo "$v"; return; }
  pacman -Q claude-desktop 2>/dev/null | awk '{print $2}' | cut -d- -f1
}
desk_latest()  {
  curl -fsSL --max-time "$NET_TIMEOUT" "$APT_INDEX_URL" 2>/dev/null | awk '
    /^Version:/ {print $2}
  ' | sort -V | tail -n1
}

do_check() {
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1

  local cc cl dc dl cli_out=false desk_out=false
  cc="$(cli_current)";  cl="$(cli_latest)"
  dc="$(desk_current)"; dl="$(desk_latest)"
  newer "$cc" "$cl" && cli_out=true
  newer "$dc" "$dl" && desk_out=true

  # The cache (~/.cache/claude-update/check.json) is ALWAYS written by the check, in every mode:
  # statusline, console and doctor read it. Atomic write. Without network (both latest values
  # empty) a good cache is not overwritten with an empty one.
  if [[ -n "$cl" || -n "$dl" ]]; then
    mkdir -p "$CACHE_DIR"
    printf '{"cli":{"current":"%s","latest":"%s","outdated":%s},"desktop":{"current":"%s","latest":"%s","outdated":%s},"checked_at":%s}\n' \
      "$cc" "$cl" "$cli_out" "$dc" "$dl" "$desk_out" "$(date +%s)" > "$CACHE_DIR/check.json.tmp" \
      && mv -f "$CACHE_DIR/check.json.tmp" "$CACHE_DIR/check.json"
  fi

  if [[ $json -eq 1 ]]; then
    cat "$CACHE_DIR/check.json" 2>/dev/null || printf '{"cli":{"current":"%s","latest":"","outdated":false},"desktop":{"current":"%s","latest":"","outdated":false}}\n' "$cc" "$dc"
    [[ $cli_out == true || $desk_out == true ]] && return 10
    return 0
  fi

  # text output: one row per component, agents-multi included (it checks itself)
  if [[ $cli_out == true ]]; then cm_row wait "Claude Code" "$cc" "$(cm_t available "$cl")"
  else cm_row ok "Claude Code" "$cc" "$(cm_t latest)"; fi
  if [[ $desk_out == true ]]; then cm_row wait "Claude Desktop" "$dc" "$(cm_t available "$dl")"
  else cm_row ok "Claude Desktop" "$dc" "$(cm_t latest)"; fi
  local self_out=false
  CM_LANG="$CM_LANG" CM_COLOR="$CM_TTY" "$CM" self-update --check; [[ $? -eq 10 ]] && self_out=true
  echo
  if [[ $cli_out == true || $desk_out == true || $self_out == true ]]; then
    printf "%s\n" "$(cm_t end_avail)"
  else
    printf "%s%s%s\n" "$C_OK" "$(cm_t end_ok)" "$C_X"
  fi

  # exit 10 = at least one update available; 0 = everything up to date. Handy in shell `if`s.
  [[ $cli_out == true || $desk_out == true || $self_out == true ]] && return 10
  return 0
}

# --- Orchestration ----------------------------------------------------------
scope="all"
case "${1:-}" in
  ""|--all)    scope="all" ;;
  --cli)       scope="cli" ;;
  --desktop)   scope="desktop" ;;
  --self)      scope="self" ;;
  --auto)      scope="auto" ;;
  --check)     do_check "${2:-}"; exit $? ;;
  --rollback)
    if [[ "${2:-}" == "--desktop" ]]; then "$BIN_DIR/claude-desktop-update" --rollback; exit $?; fi
    take_lock; do_rollback; exit $? ;;
  -h|--help)   sed -n '2,22p' "$0"; exit 0 ;;
  *) echo "Usage: claude-update [--cli|--desktop|--self|--auto|--check [--json]|--rollback [--desktop]]  (default: all)" >&2; exit 2 ;;
esac

# --auto: the timer's run. Updates whatever the check finds outdated, without asking and without
# output (failures go to the log and the journal). Desktop is updated even when the check fails: an
# already-staged version is only waiting for the app to be closed.
if [[ "$scope" == "auto" ]]; then
  take_lock
  do_check --json >/dev/null; state="$(cat "$CACHE_DIR/check.json" 2>/dev/null)"
  if grep -q '"cli":{[^}]*"outdated":true' <<<"$state"; then
    from="$(cli_current)"
    # not as an `if` condition: bash would disable the subshell's `set -e` there (see below)
    do_cli >/dev/null 2>&1; rc=$?
    if [[ $rc -eq 0 ]]; then cm_update_log cli installed "$from" "$(cli_current)" ""
    else cm_update_log cli failed "$from" "" "$(tail -n 3 "$NOTES")"; cat "$NOTES" >&2; fi
  fi
  QUIET=1 "$BIN_DIR/claude-desktop-update" >/dev/null; rc=$?
  do_check --json >/dev/null 2>&1 || true
  # last: it may restart the console, which could be what started this run
  "$CM" self-update --quiet; src=$?
  [[ $rc -eq 0 || $rc -eq 5 ]] && [[ $src -eq 0 ]] || exit 1
  exit 0
fi

take_lock
failed=0
# the title only for the full run: with --cli, --desktop or --self the row is enough
[[ "$scope" == "all" ]] && printf "\n%s%s%s\n\n" "$C_B" "$(cm_t title)" "$C_X"

# Note: do_cli is a subshell with an internal `set -e`. Do NOT invoke it as an `if` condition
# (`if do_cli; then`): in that context bash DISABLES the subshell's `set -e` for its whole run, so
# a failing command would not abort and the failure would be masked as a false "ok". It is called
# directly and $? captured (the internal `set -e` is active again). The top-level script has no
# `set -e`, so a non-zero rc does not make it exit.
if [[ "$scope" == "all" || "$scope" == "cli" ]]; then
  cm_working "Claude Code"
  CLI_FROM="$(cli_current)"
  do_cli; rc=$?
  now="$(cli_current)"
  if [[ $rc -ne 0 ]]; then
    cm_row fail "Claude Code" "$CLI_FROM" "$(cm_t failed)"; failed=1
    cm_update_log cli failed "$CLI_FROM" "" "manual update failed"
  elif [[ "$CLI_FROM" != "$now" ]]; then
    if [[ -n "$CLI_FROM" ]]; then cm_row new "Claude Code" "$now" "$(cm_t updated "$CLI_FROM")"
    else cm_row new "Claude Code" "$now" "$(cm_t installed)"; fi
    cm_update_log cli installed "$CLI_FROM" "$now" ""
  else
    cm_row ok "Claude Code" "$now" "$(cm_t latest)"
  fi
  show_notes
fi

if [[ "$scope" == "all" || "$scope" == "desktop" ]]; then
  cm_working "Claude Desktop"
  from="$(desk_current)"
  do_desktop; rc=$?
  now="$(desk_current)"
  case $rc in
    0) if [[ -n "$from" && "$from" != "$now" ]]; then cm_row new "Claude Desktop" "$now" "$(cm_t updated "$from")"
       else cm_row ok "Claude Desktop" "$now" "$(cm_t latest)"; fi ;;
    5) cm_row wait "Claude Desktop" "$now" "$(cm_t desk_wait "$("$BIN_DIR/claude-desktop-update" --staged 2>/dev/null)")"; : > "$NOTES" ;;
    3) cm_row wait "Claude Desktop" "$now" "$(cm_t busy)"; : > "$NOTES" ;;
    4) cm_row fail "Claude Desktop" "$now" "$(cm_t desk_verify)"; failed=1 ;;
    *) cm_row fail "Claude Desktop" "$now" "$(cm_t failed)"; failed=1 ;;
  esac
  # error lines carry the command prefix: the name is already in the row
  sed -i 's/^claude-desktop-update: //' "$NOTES"
  show_notes
fi

if [[ "$scope" == "all" || "$scope" == "self" ]]; then
  cm_working "agents-multi"
  [[ -n "$CM_TTY" ]] && printf "\r\e[K"
  CM_LANG="$CM_LANG" CM_COLOR="$CM_TTY" "$CM" self-update || failed=1
fi

# The check cache (statusline, console) describes the state before the update: regenerate it now.
do_check --json >/dev/null 2>&1 || true

echo
if [[ $failed -ne 0 ]]; then
  printf "%s%s%s\n" "$C_BAD" "$(cm_t end_fail)" "$C_X" >&2
  exit 1
fi
printf "%s%s%s\n" "$C_OK" "$(cm_t end_ok)" "$C_X"
