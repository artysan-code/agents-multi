#!/usr/bin/env bash
# claude-update: orchestratore aggiornamenti dell'intero setup Claude multi-account.
#
#   [CLI]     Claude Code   — updater interno + ripristino di claude-bin e del wrapper ~/.local/bin/claude
#   [Desktop] Claude Desktop — claude-desktop-update: .deb ufficiale verificato, in user space, niente root
#   [Self]    claude-multi   — il repo stesso: pull solo fast-forward a working tree pulito, poi riavvio di
#                              console e app se il loro codice è cambiato e install a Claude chiuso (cli/selfupdate.ts)
#
# USO:
#   claude-update              # tutto: CLI + Desktop + claude-multi
#   claude-update --cli        # solo Claude Code
#   claude-update --desktop    # solo Claude Desktop (tutte le varianti)
#   claude-update --self       # solo claude-multi
#   claude-update --auto       # quello che fa il timer: controlla e aggiorna ciò che è indietro, in silenzio
#   claude-update --check      # NON aggiorna: dice solo cosa è obsoleto (--json per gli script)
#   claude-update --rollback [--desktop]   # torna alla versione precedente (Code, o Desktop)
#
# Ogni esito finisce nel registro (~/.local/state/claude-multi/updates.jsonl, bin/lib/updates.sh).
# L'unica notifica è una verifica fallita: tutto il resto si legge nella console.
#
# I due sotto-aggiornamenti girano ISOLATI: il fallimento di uno NON blocca l'altro.
# Una riga per componente (bin/lib/ui.sh), con sotto solo i dettagli che contano; exit != 0 se qualcosa è fallito.
#
# NB: niente `set -e` a livello top — i fallimenti sono gestiti a mano (subshell + report).
#     Ogni componente ha il proprio `set -e` dentro la sua subshell.
set -uo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/profiles.sh"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/updates.sh"
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/ui.sh"

VERSIONS_DIR="$HOME/.local/share/claude/versions"
REPO_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
CM="$REPO_DIR/bin/claude-multi"
BIN_DIR="$HOME/.local/bin"

# Canale usato dall'updater nativo: `stable` è indietro di qualche release (rollout graduale),
# `latest` è ciò che `claude update` installa davvero. Confrontare con `stable` darebbe
# falsi "aggiornamento disponibile"/"già aggiornato" rispetto a quello che poi succede.
# (le URL sono override-abili via env: per provare un aggiornamento senza aspettare una release vera)
CLI_CHANNEL_URL="${CLAUDE_CLI_CHANNEL_URL:-https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/latest}"
APT_INDEX_URL="${CLAUDE_APT_INDEX_URL:-https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages}"
NET_TIMEOUT="${CLAUDE_UPDATE_TIMEOUT:-8}"
CACHE_DIR="$HOME/.cache/claude-update"
LOCK_FILE="$CACHE_DIR/update.lock"

# Un solo aggiornamento alla volta (timer, avvio e terminale possono coincidere).
take_lock() {
  mkdir -p "$CACHE_DIR"
  exec 8>"$LOCK_FILE"
  if ! flock -n 8; then
    echo "ERROR: un altro claude-update è in corso (lock $LOCK_FILE)" >&2
    exit 3
  fi
}

# Rollback: claude-bin torna alla versione precedente ancora in cache (il prune ne tiene una).
do_rollback() (
  set -e
  local cur prev
  cur="$(basename "$(readlink -f "$BIN_DIR/claude-bin")")"
  prev="$(ls -1v "$VERSIONS_DIR" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | grep -vx "$cur" | tail -n1 || true)"
  [[ -n "$prev" ]] || { echo "ERROR: nessuna versione precedente in $VERSIONS_DIR (il prune tiene solo N-1)" >&2; exit 1; }
  ln -sfn "$VERSIONS_DIR/$prev" "$BIN_DIR/claude-bin"
  cm_update_log cli rollback "$cur" "$prev" ""
  cm_row ok "Claude Code" "$prev" "$(cm_t rolled "$prev")"
  cm_note "$(cm_t forward "$cur")"
)

# --- [CLI] Claude Code ------------------------------------------------------
# L'updater interno scarica in ~/.local/share/claude/versions/ e ricrea ~/.local/bin/claude
# come symlink: questo bypassa il tripwire e lascia claude-bin (usato dai wrapper di
# profilo) puntato alla vecchia versione. Qui rimettiamo a posto entrambi.
# Silenzioso: i dettagli da mostrare sotto la riga vanno in $NOTES (uno per riga), l'output
# dell'updater nativo solo se fallisce.
NOTES="$(mktemp)"; trap 'rm -f -- "$NOTES"' EXIT
note() { printf '%s\n' "$1" >> "$NOTES"; }
show_notes() { local l; while IFS= read -r l; do [[ -n "$l" ]] && cm_note "$l"; done < "$NOTES"; : > "$NOTES"; }

do_cli() (
  set -e
  # NB: lo shell dell'utente esporta DISABLE_AUTOUPDATER=1 (vedi .zshrc) e i wrapper di
  # profilo pure; in quel contesto il subcomando `update` può essere soppresso. Invochiamo
  # il binario DIRETTO strippando quel flag, così l'update esplicito gira sempre. Il binario
  # è condiviso: aggiornarlo una volta basta per tutti i profili.
  local cbin="$BIN_DIR/claude-bin"
  [[ -x "$cbin" ]] || cbin="$VERSIONS_DIR/$(ls -1v "$VERSIONS_DIR" | tail -n1)"

  # CLAUDE_CONFIG_DIR usa-e-getta: `update` scarica solo il binario, non ha bisogno dello
  # stato di un profilo — e scriverci dentro lo sporcherebbe. Puntava a
  # ~/.claude-multi/work, nome morto dopo il rename del profilo (→ agency): la dir veniva
  # RICREATA vuota a ogni update e il doctor la segnalava come runtime senza profilo.
  local tmpcfg; tmpcfg="$(mktemp -d)"
  trap 'rm -rf -- "$tmpcfg"' EXIT

  # Cattura l'output per filtrare il blocco Warning/Fix noto: l'updater nativo avvisa che
  # ~/.local/bin/claude non è un suo symlink — ma è il tripwire, VOLUTO → puro rumore.
  # Preserviamo l'exit code reale: un fallimento vero propaga (do_cli → FAIL), non lo mascheriamo.
  # `|| rc=$?` evita che `set -e` abortisca sul non-zero prima di catturarlo; `|| true` protegge
  # dal caso (teorico) in cui grep filtri tutto e ritorni 1 sotto pipefail.
  local out rc=0
  out="$(env -u DISABLE_AUTOUPDATER CLAUDE_CONFIG_DIR="$tmpcfg" "$cbin" update 2>&1)" || rc=$?
  if [[ $rc -ne 0 ]]; then
    printf '%s\n' "$out" | grep -vE '^\s*$|was not created by the native installer|If you put a launcher wrapper there on purpose' | tail -n 4 >> "$NOTES" || true
    exit $rc
  fi

  local latest
  latest="$(ls -1v "$VERSIONS_DIR" | tail -n1)"
  [[ -n "$latest" ]] || { note "nessuna versione in $VERSIONS_DIR"; exit 1; }

  ln -sfn "$VERSIONS_DIR/$latest" "$BIN_DIR/claude-bin"

  # GC delle versioni vecchie: l'updater nativo la DISABILITA perché il launcher è custom
  # (è il warning noto "keeps them all"). Senza questo, versions/ cresce a ogni update
  # (~275 MB a botta).
  # NB: le versioni sono FILE ELF singoli (`versions/2.1.220`), non directory — il glob
  # `*/` di prima non matchava nulla e il GC era di fatto morto. Ora iteriamo su tutte le
  # entry, filtrando per nome semver: così non tocchiamo mai file estranei finiti lì.
  # Guardie: mai la live ($latest, validata non-vuota sopra e bersaglio di claude-bin).
  # Cancellare l'ELF di una sessione in corso è innocuo: l'inode resta vivo fino all'exit.
  # Si tiene anche la penultima (N-1) per `claude-multi update --rollback`.
  local v bn prev pruned=()
  prev="$(ls -1v "$VERSIONS_DIR" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | grep -vx "$latest" | tail -n1 || true)"
  for v in "$VERSIONS_DIR"/*; do
    [[ -e "$v" ]] || continue
    bn="$(basename "$v")"
    [[ "$bn" == "$latest" || "$bn" == "$prev" ]] && continue
    [[ "$bn" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    pruned+=("$bn")
    rm -rf -- "$v"
  done
  (( ${#pruned[@]} )) && note "$(cm_t pruned "${pruned[*]}")"
  [[ -n "$prev" && "${CLI_FROM:-}" != "$latest" ]] && note "$(cm_t keep "$prev")"

  # L'updater nativo riscrive ~/.local/bin/claude come symlink alla nuova versione: lo
  # rimettiamo al wrapper del repo (profilo personal). Gli altri launcher non sono toccati.
  local repo; repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
  if [[ "$(readlink "$BIN_DIR/claude")" != "$repo/bin/claude" ]]; then
    ln -sfn "$repo/bin/claude" "$BIN_DIR/claude"
    note "$(cm_t wrapper)"
  fi

  # Deep-link handler (claude-cli://): l'auto-generato punta a ~/.local/bin/claude, che dopo
  # il flip è il tripwire → i deep-link (login/IDE) si romperebbero. Ripunta a claude-bin.
  local handler="$HOME/.local/share/applications/claude-code-url-handler.desktop"
  if [[ -f "$handler" ]] && grep -q -- '--handle-uri' "$handler" && ! grep -qF -- "Exec=\"$BIN_DIR/claude-bin\" --handle-uri" "$handler"; then
    sed -i -E 's#^Exec=.*--handle-uri#Exec="'"$BIN_DIR"'/claude-bin" --handle-uri#' "$handler"
    note "$(cm_t handler)"
  fi
  true
)

# --- [Desktop] Claude Desktop (tutte le varianti) ---------------------------
# claude-desktop-update scarica, verifica ed estrae in user space; la versione nuova entra in uso
# (con le varianti ricostruite) solo quando nessun Claude Desktop è aperto. Exit 5 = pronta ma in
# attesa: non è un fallimento.
do_desktop() {
  QUIET=1 "$BIN_DIR/claude-desktop-update" 2>>"$NOTES" >/dev/null
}

# --- Check versioni (nessuna scrittura) -------------------------------------
# Economico e non bloccante: l'indice apt è ~19 KB, il canale CLI ~10 byte. Ogni fetch ha timeout;
# in mancanza di rete i campi `latest` restano vuoti e `outdated` è false.

# newer A B → vero se B è strettamente più recente di A (ordinamento semver via sort -V).
# Evita di proporre un "aggiornamento" quando il canale remoto è più indietro del locale.
newer() {
  local a="$1" b="$2"
  [[ -n "$b" ]] || return 1
  [[ "$a" == "$b" ]] && return 1
  [[ -z "$a" ]] && return 0
  [[ "$(printf '%s\n%s\n' "$a" "$b" | sort -V | tail -n1)" == "$b" ]]
}

cli_current()  { basename "$(readlink -f "$BIN_DIR/claude-bin" 2>/dev/null)" 2>/dev/null || true; }
cli_latest()   { curl -fsSL --max-time "$NET_TIMEOUT" "$CLI_CHANNEL_URL" 2>/dev/null | tr -d '[:space:]'; }
# la versione in uso in user space; prima della migrazione, quella del pacchetto di sistema
desk_current() {
  local v; v="$("$BIN_DIR/claude-desktop-update" --current 2>/dev/null)"
  [[ -n "$v" ]] && { echo "$v"; return; }
  pacman -Q claude-desktop 2>/dev/null | awk '{print $2}' | cut -d- -f1
}
desk_latest()  {
  curl -fsSL --max-time "$NET_TIMEOUT" "$APT_INDEX_URL" 2>/dev/null | awk '
    /^Version:/ {print $2}
  ' | sort -V | tail -n1
}

do_check() {
  local json=0
  [[ "${1:-}" == "--json" ]] && json=1

  local cc cl dc dl cli_out=false desk_out=false
  cc="$(cli_current)";  cl="$(cli_latest)"
  dc="$(desk_current)"; dl="$(desk_latest)"
  newer "$cc" "$cl" && cli_out=true
  newer "$dc" "$dl" && desk_out=true

  # La cache (~/.cache/claude-update/check.json) la scrive SEMPRE il check, in qualunque modalità:
  # è ciò che leggono statusline, console e doctor. Scrittura atomica. Senza rete (entrambi i
  # latest vuoti) non si sovrascrive una cache buona con una vuota.
  if [[ -n "$cl" || -n "$dl" ]]; then
    mkdir -p "$CACHE_DIR"
    printf '{"cli":{"current":"%s","latest":"%s","outdated":%s},"desktop":{"current":"%s","latest":"%s","outdated":%s},"checked_at":%s}\n' \
      "$cc" "$cl" "$cli_out" "$dc" "$dl" "$desk_out" "$(date +%s)" > "$CACHE_DIR/check.json.tmp" \
      && mv -f "$CACHE_DIR/check.json.tmp" "$CACHE_DIR/check.json"
  fi

  if [[ $json -eq 1 ]]; then
    cat "$CACHE_DIR/check.json" 2>/dev/null || printf '{"cli":{"current":"%s","latest":"","outdated":false},"desktop":{"current":"%s","latest":"","outdated":false}}\n' "$cc" "$dc"
    [[ $cli_out == true || $desk_out == true ]] && return 10
    return 0
  fi

  # il testo: una riga per componente, claude-multi compreso (che si controlla da sé)
  if [[ $cli_out == true ]]; then cm_row wait "Claude Code" "$cc" "$(cm_t available "$cl")"
  else cm_row ok "Claude Code" "$cc" "$(cm_t latest)"; fi
  if [[ $desk_out == true ]]; then cm_row wait "Claude Desktop" "$dc" "$(cm_t available "$dl")"
  else cm_row ok "Claude Desktop" "$dc" "$(cm_t latest)"; fi
  local self_out=false
  CM_LANG="$CM_LANG" CM_COLOR="$CM_TTY" "$CM" self-update --check; [[ $? -eq 10 ]] && self_out=true
  echo
  if [[ $cli_out == true || $desk_out == true || $self_out == true ]]; then
    printf "%s\n" "$(cm_t end_avail)"
  else
    printf "%s%s%s\n" "$C_OK" "$(cm_t end_ok)" "$C_X"
  fi

  # exit 10 = c'e' almeno un aggiornamento; 0 = tutto allineato. Comodo negli `if` di shell.
  [[ $cli_out == true || $desk_out == true || $self_out == true ]] && return 10
  return 0
}

# --- Orchestrazione ---------------------------------------------------------
scope="all"
case "${1:-}" in
  ""|--all)    scope="all" ;;
  --cli)       scope="cli" ;;
  --desktop)   scope="desktop" ;;
  --self)      scope="self" ;;
  --auto)      scope="auto" ;;
  --check)     do_check "${2:-}"; exit $? ;;
  --rollback)
    if [[ "${2:-}" == "--desktop" ]]; then "$BIN_DIR/claude-desktop-update" --rollback; exit $?; fi
    take_lock; do_rollback; exit $? ;;
  -h|--help)   sed -n '2,22p' "$0"; exit 0 ;;
  *) echo "Uso: claude-update [--cli|--desktop|--self|--auto|--check [--json]|--rollback [--desktop]]  (default: tutti)" >&2; exit 2 ;;
esac

# --auto: il giro del timer. Aggiorna ciò che il check trova indietro, senza chiedere e senza
# output (i fallimenti vanno nel registro e nel journal). Desktop si aggiorna anche quando il check
# fallisce: una versione già pronta aspetta solo che l'app venga chiusa.
if [[ "$scope" == "auto" ]]; then
  take_lock
  do_check --json >/dev/null; state="$(cat "$CACHE_DIR/check.json" 2>/dev/null)"
  if grep -q '"cli":{[^}]*"outdated":true' <<<"$state"; then
    from="$(cli_current)"
    # non come condizione di `if`: lì bash spegnerebbe il `set -e` della subshell (vedi sotto)
    do_cli >/dev/null 2>&1; rc=$?
    if [[ $rc -eq 0 ]]; then cm_update_log cli installed "$from" "$(cli_current)" ""
    else cm_update_log cli failed "$from" "" "$(tail -n 3 "$NOTES")"; cat "$NOTES" >&2; fi
  fi
  QUIET=1 "$BIN_DIR/claude-desktop-update" >/dev/null; rc=$?
  do_check --json >/dev/null 2>&1 || true
  # per ultimo: può riavviare la console, che potrebbe essere chi ha lanciato questo giro
  "$CM" self-update --quiet; src=$?
  [[ $rc -eq 0 || $rc -eq 5 ]] && [[ $src -eq 0 ]] || exit 1
  exit 0
fi

take_lock
failed=0
# il titolo solo per il giro completo: con --cli, --desktop o --self la riga basta
[[ "$scope" == "all" ]] && printf "\n%s%s%s\n\n" "$C_B" "$(cm_t title)" "$C_X"

# NB: do_cli è una subshell con `set -e` interno. NON invocarla come condizione di `if`
# (`if do_cli; then`): in quel contesto bash DISABILITA il `set -e` della subshell per tutta la sua
# durata → un comando fallito NON aborta e il fallimento viene mascherato da un falso "ok". La
# chiamiamo diretta e catturiamo $? (qui il `set -e` interno è di nuovo attivo). Lo script top-level
# non ha `set -e`, quindi un rc!=0 non ci fa uscire.
if [[ "$scope" == "all" || "$scope" == "cli" ]]; then
  cm_working "Claude Code"
  CLI_FROM="$(cli_current)"
  do_cli; rc=$?
  now="$(cli_current)"
  if [[ $rc -ne 0 ]]; then
    cm_row fail "Claude Code" "$CLI_FROM" "$(cm_t failed)"; failed=1
    cm_update_log cli failed "$CLI_FROM" "" "manual update failed"
  elif [[ "$CLI_FROM" != "$now" ]]; then
    cm_row new "Claude Code" "$now" "$(cm_t updated "$CLI_FROM")"
    cm_update_log cli installed "$CLI_FROM" "$now" ""
  else
    cm_row ok "Claude Code" "$now" "$(cm_t latest)"
  fi
  show_notes
fi

if [[ "$scope" == "all" || "$scope" == "desktop" ]]; then
  cm_working "Claude Desktop"
  from="$(desk_current)"
  do_desktop; rc=$?
  now="$(desk_current)"
  case $rc in
    0) if [[ -n "$from" && "$from" != "$now" ]]; then cm_row new "Claude Desktop" "$now" "$(cm_t updated "$from")"
       else cm_row ok "Claude Desktop" "$now" "$(cm_t latest)"; fi ;;
    5) cm_row wait "Claude Desktop" "$now" "$(cm_t desk_wait "$("$BIN_DIR/claude-desktop-update" --staged 2>/dev/null)")"; : > "$NOTES" ;;
    3) cm_row wait "Claude Desktop" "$now" "$(cm_t busy)"; : > "$NOTES" ;;
    4) cm_row fail "Claude Desktop" "$now" "$(cm_t desk_verify)"; failed=1 ;;
    *) cm_row fail "Claude Desktop" "$now" "$(cm_t failed)"; failed=1 ;;
  esac
  # le righe di errore arrivano col prefisso del comando: qui il nome è già nella riga
  sed -i 's/^claude-desktop-update: //' "$NOTES"
  show_notes
fi

if [[ "$scope" == "all" || "$scope" == "self" ]]; then
  cm_working "claude-multi"
  [[ -n "$CM_TTY" ]] && printf "\r\e[K"
  CM_LANG="$CM_LANG" CM_COLOR="$CM_TTY" "$CM" self-update || failed=1
fi

# La cache del check (statusline, console) descrive il mondo di prima: si rigenera subito.
do_check --json >/dev/null 2>&1 || true

echo
if [[ $failed -ne 0 ]]; then
  printf "%s%s%s\n" "$C_BAD" "$(cm_t end_fail)" "$C_X" >&2
  exit 1
fi
printf "%s%s%s\n" "$C_OK" "$(cm_t end_ok)" "$C_X"
