# Maintainer: Samuel <samu.tagliacozzo@gmail.com>
#
# claude-desktop: repackage del .deb UFFICIALE Anthropic in un pacchetto Arch.
# La supply chain resta pulita: il binario è quello firmato da Anthropic, scaricato
# dal loro pool apt. Questo PKGBUILD NON compila nulla: estrae il data.tar del .deb
# e lo installa 1:1 sotto /usr (stesso layout della .deb Debian).
#
# I campi pkgver / pkgrel / sha256sums_x86_64 vengono patchati automaticamente da
# `claude-desktop-update` (sed) prima di makepkg. Non modificarli a mano se usi quel flusso.

pkgname=claude-desktop
pkgver=1.40609.1
pkgrel=1
pkgdesc="Claude Desktop (repackage del .deb ufficiale Anthropic)"
arch=('x86_64')
url="https://claude.ai/download"
license=('LicenseRef-Anthropic')
depends=('gtk3' 'nss' 'alsa-lib' 'libnotify')
options=('!strip' '!debug')
install="${pkgname}.install"

# Il file locale si chiama come il source: così, quando claude-desktop-update copia un
# .deb già scaricato in questa dir con lo sha giusto, makepkg lo valida e NON riscarica.
source_x86_64=("claude-desktop_${pkgver}_amd64.deb::https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${pkgver}_amd64.deb")
noextract=("claude-desktop_${pkgver}_amd64.deb")
# Placeholder: claude-desktop-update lo rimpiazza con lo sha reale prima di buildare.
sha256sums_x86_64=('80182e8511c6bbee6de26c7ee225fbd2a9aba2274ef1405a1d89cd8fe7a380dc')

package() {
  cd "$srcdir"
  local deb="claude-desktop_${pkgver}_amd64.deb"

  # Un .deb è un archivio `ar`: debian-binary + control.tar.* + data.tar.*
  # bsdtar (libarchive) legge sia l'ar che il data.tar interno (xz/zst/gz).
  local data
  data="$(bsdtar -tf "$deb" | grep -m1 '^data\.tar')"
  [[ -n "$data" ]] || { echo "ERRORE: data.tar non trovato dentro $deb" >&2; return 1; }

  # Estrai SOLO il data.tar e spacchettalo in $pkgdir preservando i permessi.
  bsdtar -xOf "$deb" "$data" | bsdtar -xpf - -C "$pkgdir"

  # chrome-sandbox deve restare setuid root, altrimenti la sandbox di Electron non parte.
  if [[ -e "$pkgdir/usr/lib/claude-desktop/chrome-sandbox" ]]; then
    chmod 4755 "$pkgdir/usr/lib/claude-desktop/chrome-sandbox"
  fi
}
