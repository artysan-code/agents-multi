pkgdesc="Several Claude Code and Claude Desktop accounts on one machine, one console for all"
arch=('x86_64')
url="https://github.com/artysan-code/agents-multi"
license=('AGPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'hicolor-icon-theme')
provides=('agents-multi')
conflicts=('agents-multi')
# the bundled Deno is a release binary of its own: stripping it again gains nothing
options=('!strip' '!debug')
source_x86_64=("https://github.com/artysan-code/agents-multi/releases/download/v${pkgver}/agents-multi_${pkgver}_amd64.deb")
sha256sums_x86_64=('7e66d0f1bba455d7e18ed4fc0d3acdd3f6bd028bf4bf8f24d0d451c9132a7541')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  # pacman updates the app: its own updater stays off (apps/desktop/src-tauri/src/updater.rs)
  printf 'pacman\n' > "$pkgdir/usr/lib/me.artysan.agents/package-manager"
  # the licence carries additional terms (attribution): its text goes where pacman looks for it
  for f in LICENSE THIRD_PARTY_NOTICES.md; do
    install -Dm644 "$pkgdir/usr/lib/me.artysan.agents/repo/$f" "$pkgdir/usr/share/licenses/$pkgname/$f"
  done
}
