{
  "version": "1.2.1-rc.3",
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.32.1",
    "zod": "npm:zod@4.6.5",
    "unpdf": "npm:unpdf@1.8.1",
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1"
  },
  "tasks": {
    "check": "bash scripts/check.sh",
    "test": "bash scripts/test.sh",
    "ci": "bash scripts/ci.sh",
    "doctor": "deno run --quiet --allow-read --allow-write --allow-run --allow-env --allow-sys=hostname,loadavg,systemMemoryInfo --allow-net=127.0.0.1:8384,127.0.0.1:7331,127.0.0.1:8789 apps/cli/main.ts doctor",
    "release": "deno run --allow-read --allow-write --allow-run=git scripts/release.ts",
    "ship": "deno run --allow-read --allow-write --allow-run scripts/ship.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "proseWrap": "preserve",
    "exclude": [
      ".claude/",
      "apps/site/",
      "apps/ui/",
      "apps/desktop/pnpm-lock.yaml",
      "shared/skills/graphify/",
      "desktop/icons/",
      "**/*.svg"
    ]
  },
  "lint": {
    "exclude": [
      ".claude/",
      "apps/site/",
      "apps/ui/"
    ],
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
