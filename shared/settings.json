{
  "permissions": {
    "allow": [
      "mcp__tasks"
    ],
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.config/secrets/**)",
      "Edit(~/.aws/**)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(secret-tool:*)",
      "Bash(kwallet-query:*)",
      "Bash(agents vault recovery-code:*)",
      "Bash(agents-multi vault recovery-code:*)",
      "Bash(claude-multi vault recovery-code:*)",
      "Read(~/vault/claude-multi/**)",
      "Edit(~/vault/claude-multi/**)"
    ],
    "ask": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "mcp__google__gmail_send",
      "mcp__google__calendar_delete"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/read-guard-global.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/destructive-blocker.sh"
          },
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/vault-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/branch-guard.sh"
          },
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/graphify-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/graphify-nudge.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/memory-legacy-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/commit-trailer-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/agents-md-nested.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/typecheck-after-edit.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/brain-nudge.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/notify-stop.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME\"/.claude-multi/shared/hooks/session-persist.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude-multi/shared/hooks/brain-checkpoint.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME\"/.claude-multi/shared/statusline-command.sh"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "claude-code-lsps": {
      "source": {
        "source": "github",
        "repo": "Piebald-AI/claude-code-lsps"
      }
    }
  },
  "disableDeepLinkRegistration": "disable",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  }
}
