{
  "$schema-note": "Registry MCP unico dei profili claude-multi. Sorgente di verita': modifica QUI, poi `claude-multi mcp sync` (a Claude chiuso). Campi: _profiles (default: TUTTI i profili dichiarati in profiles/*/profile.json), _surfaces (cli|desktop, default cli). Nessun elenco di profili qui: si deriva dai manifest. _service: il server è legato agli account di quel servizio (shared/mcp/accounts.json): mcp sync lo dà solo ai profili che ne vedono almeno uno, gli passa CLAUDE_MULTI_PROFILE e sostituisce {hosts} con gli host di quegli account (per --allow-net). I secret stanno nel vault, mai qui.",
  "servers": {
    "syncthing-status": {
      "command": "deno",
      "args": [
        "run",
        "--allow-net=127.0.0.1:8384",
        "--allow-read=~",
        "--allow-env=HOME,ST_URL,ST_CONFIG,STGUI_APIKEY",
        "--allow-run=git",
        "--lock=~/.claude-multi/shared/mcp/syncthing-status/deno.lock",
        "~/.claude-multi/shared/mcp/syncthing-status/server.ts"
      ]
    },
    "n8n": {
      "_service": "n8n",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net={hosts}",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/n8n/deno.lock",
        "~/.claude-multi/shared/mcp/n8n/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ]
    },
    "coolify": {
      "_service": "coolify",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net={hosts}",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/coolify/deno.lock",
        "~/.claude-multi/shared/mcp/coolify/server.ts"
      ]
    },
    "tasks": {
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net={hosts}",
        "--allow-read=~/brains/tasks,~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-write=~/brains/tasks",
        "--allow-env=HOME,CLAUDE_MULTI_TASKS,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_BRAIN_SCOPE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/tasks/deno.lock",
        "~/.claude-multi/shared/mcp/tasks/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ],
      "_service": "brain",
      "_note": "Le task stanno nel brain (shared/mcp/lib/brain-tasks.ts): _service brain dà l'host e il profilo, il token personale sta nel vault (brain/brain). ~/brains/tasks resta per settings.json e i file allegati dalla console. Un profilo di lavoro (brainScope nel manifest) riceve CLAUDE_MULTI_BRAIN_SCOPE e vede solo le task di quei progetti."
    },
    "google": {
      "_service": "google",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net=oauth2.googleapis.com,gmail.googleapis.com,www.googleapis.com",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/google/deno.lock",
        "~/.claude-multi/shared/mcp/google/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ]
    }
  }
}
