{
  "$schema-note": "Registry MCP unico dei profili claude-multi. Sorgente di verita': modifica QUI, poi `claude-multi mcp sync` (a Claude chiuso). Campi: _profiles (default: TUTTI i profili dichiarati in profiles/*/profile.json), _surfaces (cli|desktop, default cli). Nessun elenco di profili qui: si deriva dai manifest. wiki-claude: binario pnpm globale (pnpm add -g obsidian-brain), non npx: a freddo npx falliva la connessione. EMBEDDING_PROVIDER=ollama e' solo il PROTOCOLLO: sulla 11434 risponde llama-embed-shim (shared/tools) davanti a llama-server di llama.cpp (bge-m3, Vulkan), non Ollama. _service: il server è legato agli account di quel servizio (shared/mcp/accounts.json): mcp sync lo dà solo ai profili che ne vedono almeno uno, gli passa CLAUDE_MULTI_PROFILE e sostituisce {hosts} con gli host di quegli account (per --allow-net). I secret stanno nel vault, mai qui.",
  "servers": {
    "wiki-claude": {
      "type": "stdio",
      "command": "~/.local/share/pnpm/bin/obsidian-brain",
      "args": [
        "server"
      ],
      "env": {
        "VAULT_PATH": "~/brains/claude",
        "EMBEDDING_PROVIDER": "ollama",
        "EMBEDDING_MODEL": "bge-m3",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "OLLAMA_EMBEDDING_DIM": "1024",
        "OBSIDIAN_BRAIN_NO_WATCH": "1",
        "PATH": "~/.nvm/versions/node/v24.21.0/bin:~/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin"
      },
      "_note": "PATH pinnato: obsidian-brain carica better-sqlite3 (modulo nativo) e deve girare SEMPRE con lo stesso Node (nvm 24, ABI 137). Con /usr/bin/node (26, ABI 147) davanti nel PATH il modulo non carica e l'MCP muore in 'connection closed' (incidente 2026-09-04). Se cambi Node: aggiorna qui e ricompila (claude-multi mcp health --probe lo verifica)."
    },
    "syncthing-status": {
      "command": "deno",
      "args": [
        "run",
        "--allow-net=127.0.0.1:8384",
        "--allow-read=~",
        "--allow-env=HOME,ST_URL,ST_CONFIG,STGUI_APIKEY",
        "--allow-run=git",
        "--lock=~/.claude-multi/shared/mcp/syncthing-status/deno.lock",
        "~/.claude-multi/shared/mcp/syncthing-status/server.ts"
      ]
    },
    "n8n": {
      "_service": "n8n",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net={hosts}",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/n8n/deno.lock",
        "~/.claude-multi/shared/mcp/n8n/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ]
    },
    "coolify": {
      "_service": "coolify",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net={hosts}",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/coolify/deno.lock",
        "~/.claude-multi/shared/mcp/coolify/server.ts"
      ]
    },
    "tasks": {
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-read=~/brains/tasks,~/.cache/deno",
        "--allow-write=~/brains/tasks",
        "--allow-env=HOME,CLAUDE_MULTI_TASKS",
        "--lock=~/.claude-multi/shared/mcp/tasks/deno.lock",
        "~/.claude-multi/shared/mcp/tasks/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ]
    },
    "google": {
      "_service": "google",
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--quiet",
        "--allow-net=oauth2.googleapis.com,gmail.googleapis.com,www.googleapis.com",
        "--allow-read=~/vault/claude-multi,~/.claude-multi/shared/mcp/accounts.json,~/.cache/deno",
        "--allow-env=HOME,CLAUDE_MULTI_PROFILE,CLAUDE_MULTI_VAULT,CLAUDE_MULTI_ACCOUNTS",
        "--allow-run=/usr/bin/secret-tool",
        "--lock=~/.claude-multi/shared/mcp/google/deno.lock",
        "~/.claude-multi/shared/mcp/google/server.ts"
      ],
      "_surfaces": [
        "cli",
        "desktop"
      ]
    }
  }
}
