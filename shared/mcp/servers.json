{
  "$schema-note": "Registry MCP unico dei profili claude-multi. Sorgente di verita': modifica QUI, poi `claude-multi mcp sync` (a Claude chiuso). Campi: _profiles (default tutti), _surfaces (cli|desktop, default cli). wiki-claude: binario pnpm globale (pnpm add -g obsidian-brain), non npx: a freddo npx falliva la connessione. EMBEDDING_PROVIDER=ollama e' solo il PROTOCOLLO: sulla 11434 risponde llama-embed-shim (shared/tools) davanti a llama-server di llama.cpp (bge-m3, Vulkan), non Ollama.",
  "profiles": [
    "work",
    "personal"
  ],
  "servers": {
    "wiki-claude": {
      "type": "stdio",
      "command": "~/.local/share/pnpm/bin/obsidian-brain",
      "args": [
        "server"
      ],
      "env": {
        "VAULT_PATH": "~/brains/claude",
        "EMBEDDING_PROVIDER": "ollama",
        "EMBEDDING_MODEL": "bge-m3",
        "OLLAMA_BASE_URL": "http://localhost:11434",
        "OLLAMA_EMBEDDING_DIM": "1024",
        "OBSIDIAN_BRAIN_NO_WATCH": "1"
      }
    },
    "syncthing-status": {
      "command": "deno",
      "args": [
        "run",
        "--allow-net=127.0.0.1:8384",
        "--allow-read=~",
        "--allow-env=HOME,ST_URL,ST_CONFIG,STGUI_APIKEY",
        "--allow-run=git",
        "--lock=~/.claude-multi/shared/mcp/syncthing-status/deno.lock",
        "~/.claude-multi/shared/mcp/syncthing-status/server.ts"
      ]
    },
    "n8n-ark": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "set -a; . \"$HOME/.config/n8n-ark/.env\"; set +a; exec npx -y n8n-mcp"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      },
      "_surfaces": [
        "cli",
        "desktop"
      ]
    },
    "coolify-ark": {
      "_profiles": [
        "personal"
      ],
      "type": "stdio",
      "command": "deno",
      "args": [
        "run",
        "--allow-net=ark.example.com",
        "--allow-read=~/.config/secrets/coolify-ark.token,~/.cache/deno",
        "--allow-env=HOME,COOLIFY_URL,COOLIFY_TOKEN,COOLIFY_TOKEN_FILE",
        "--lock=~/.claude-multi/shared/mcp/coolify-ark/deno.lock",
        "~/.claude-multi/shared/mcp/coolify-ark/server.ts"
      ],
      "env": {}
    }
  }
}
