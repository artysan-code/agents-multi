#!/usr/bin/env bash
# claude-distiller — gestione del write-back episodico della memoria-wiki.
# Cattura (Stop hook, automatica) -> coda -> distillazione LLM (qwen3, GPU).
# Questo CLI controlla la parte manuale: distilla ora, stato, disattiva per cartella.
set -uo pipefail

HOOKS="$HOME/.claude-multi/shared/hooks"
RUN="$HOOKS/wiki-distiller-run.py"
QUEUE="$HOME/.local/share/claude-distill-queue"
SESSIONS="$HOME/brains/claude/_raw/sessions"
LOG="$QUEUE/distill.log"
OPTOUT=".claude-no-distill"
MODEL="${WIKI_DISTILL_MODEL:-qwen3:14b}"

gpu_free_gib() {
  local best="" t u f
  for tot in /sys/class/drm/card*/device/mem_info_vram_total; do
    [ -f "$tot" ] || continue
    t=$(cat "$tot" 2>/dev/null) || continue
    [ "${t:-0}" -gt 8589934592 ] 2>/dev/null || continue   # >8 GiB => dGPU
    u=$(cat "${tot/_total/_used}" 2>/dev/null || echo 0)
    f=$(( (t - u) / 1073741824 ))
    if [ -z "$best" ] || [ "$f" -gt "$best" ]; then best=$f; fi
  done
  echo "${best:-?}"
}

usage() {
cat <<EOF
claude-distiller — write-back episodico della memoria-wiki (cattura -> distilla)

USO:
  claude-distiller <comando> [opzioni]

COMANDI:
  run [--force]     Distilla ORA la coda in sospeso (usa GPU). --force ignora il
                    guard "GPU libera" (utile se sei sicuro di non star giocando).
  status            Coda, note prodotte, GPU libera, modello, stato cartella corrente.
  queue             Elenca le catture in coda (in attesa di distillazione).
  disable [PATH]    Disattiva la cattura per la cartella (default: corrente).
                    Crea PATH/$OPTOUT.
  enable  [PATH]    Riattiva la cattura per la cartella (rimuove PATH/$OPTOUT).
  logs [-f]         Mostra il log di distillazione (-f per seguirlo).
  help              Questa schermata. (anche: -h, -help, --help, nessun argomento)

NOTE:
  - La cattura e' automatica ma SOLO in sessioni del profilo personal, su cartelle
    personal/meta (~, ~/brains, ~/personal, ~/.claude-multi). Mai ~/work o profilo work.
  - Le note distillate finiscono in ~/brains/claude/_raw/sessions/ come 'needs-review'
    (nessun auto-promote: le rivedi e promuovi tu).
  - Modello attuale: $MODEL  (override: WIKI_DISTILL_MODEL=... claude-distiller run)

ESEMPI:
  claude-distiller status
  claude-distiller disable                 # niente cattura in questa cartella
  WIKI_DISTILL_MODEL=qwen3.5:9b claude-distiller run --force
EOF
}

cmd="${1:-}"
case "$cmd" in
  run)
    shift || true
    [ "${1:-}" = "--force" ] && export WIKI_DISTILL_FORCE=1
    [ -f "$RUN" ] || { echo "errore: manca $RUN" >&2; exit 1; }
    exec python3 "$RUN"
    ;;

  status)
    echo "modello:        $MODEL"
    echo "GPU libera:     $(gpu_free_gib) GiB  (soglia distill: ${WIKI_DISTILL_MIN_FREE_GIB:-12} GiB)"
    nq=$(ls "$QUEUE"/*.raw.md 2>/dev/null | wc -l | tr -d ' ')
    echo "in coda:        $nq cattura/e da distillare"
    ns=$(ls "$SESSIONS"/*.md 2>/dev/null | wc -l | tr -d ' ')
    echo "note prodotte:  $ns in _raw/sessions/ (da rivedere)"
    if [ -f "$PWD/$OPTOUT" ]; then
      echo "cartella qui:   DISATTIVATA  ($PWD/$OPTOUT presente)"
    else
      echo "cartella qui:   attiva ($PWD)"
    fi
    ;;

  queue|list)
    if ls "$QUEUE"/*.raw.md >/dev/null 2>&1; then
      for f in "$QUEUE"/*.raw.md; do
        echo "- $(basename "$f")  ($(stat -c%s "$f" 2>/dev/null) byte)"
      done
    else
      echo "coda vuota."
    fi
    ;;

  disable)
    shift || true; d="${1:-$PWD}"
    [ -d "$d" ] || { echo "errore: '$d' non e' una cartella" >&2; exit 1; }
    touch "$d/$OPTOUT" && echo "Cattura DISATTIVATA per: $d   (creato $OPTOUT)"
    ;;

  enable)
    shift || true; d="${1:-$PWD}"
    if [ -f "$d/$OPTOUT" ]; then
      rm -f "$d/$OPTOUT" && echo "Cattura riattivata per: $d   (rimosso $OPTOUT)"
    else
      echo "Gia' attiva per: $d   (nessun $OPTOUT da rimuovere)"
    fi
    ;;

  logs)
    shift || true
    [ -f "$LOG" ] || { echo "(nessun log ancora: $LOG)"; exit 0; }
    if [ "${1:-}" = "-f" ]; then tail -f "$LOG"; else tail -n 40 "$LOG"; fi
    ;;

  ""|help|-h|-help|--help)
    usage
    ;;

  *)
    echo "comando sconosciuto: $cmd" >&2
    echo
    usage
    exit 2
    ;;
esac
