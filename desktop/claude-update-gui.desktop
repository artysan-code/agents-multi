[Desktop Entry]
Type=Application
Name=Claude — aggiornamenti e stato
Comment=Pannello claude-multi: aggiornamenti di Claude Code e Claude Desktop, doctor, dashboard
Exec=~/.local/bin/claude-update-gui --standalone
Icon=claude-desktop
Terminal=false
Categories=Utility;
# Serve anche perché Wayland/xdg-portal risolva l'app info dell'app_id "claude-update-gui"
# (QApplication.setDesktopFileName): senza questa entry la finestra resta senza icona propria.
StartupWMClass=claude-update-gui
Keywords=Claude;update;doctor;claude-multi;
