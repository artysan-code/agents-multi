# Template for the per-profile Claude Desktop launchers. `claude-multi install` writes one file
# per profile from this, substituting:
#   @NAME@       display name          @PROFILE@   profile name
#   @LAUNCH@     path to claude-launch  @ICON@     icon name
#   @WMCLASS@    Wayland app_id / X11 WM_CLASS
#   @MIME@       the claude:// handler line, only on the profile that owns the scheme
#   @COMMENT@    one-line description
[Desktop Entry]
Name=@NAME@
Comment=@COMMENT@
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;@KEYWORD@
Exec=@LAUNCH@ @PROFILE@ %U
Icon=@ICON@
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from package.json desktopName,
# so docks group windows under this entry.
StartupWMClass=@WMCLASS@
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
@MIME@
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New chat
Exec=@LAUNCH@ @PROFILE@ claude://claude.ai/new

[Desktop Action NewCode]
Name=New Claude Code session
Exec=@LAUNCH@ @PROFILE@ claude://code/new
