[Desktop Entry]
Name=Claude Work
Comment=Claude Desktop — profilo Work isolato (account Agency), icona/app_id distinti
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;Work;
Exec=~/.local/bin/claude-launch work %U
Icon=claude-desktop-work
Type=Application
StartupNotify=true
StartupWMClass=claude-desktop-work
SingleMainWindow=true
Categories=Utility;
# Nessun x-scheme-handler: l'handler claude:// resta sulla "Claude" personale.
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New chat
Exec=~/.local/bin/claude-launch work claude://claude.ai/new

[Desktop Action NewCode]
Name=New Claude Code session
Exec=~/.local/bin/claude-launch work claude://code/new
