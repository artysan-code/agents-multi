#!/usr/bin/env bash
# pre-push — only what CI cannot say after the fact: the subjects of the commits about to leave (a rejected
# subject cannot be fixed once pushed). The gate itself runs in CI on the runner (scripts/ci.sh), on every push
# of dev, of an agent's branch and of a pull request; each commit already passed the pre-commit hook's check and
# tests here. `deno task ship` waits for CI's verdict. Deliberate bypass: `git push --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

deno run --quiet --allow-read --allow-run=git scripts/release.ts --lint || {
  echo "push blocked: a commit subject is not a Conventional Commit (bypass: git push --no-verify)" >&2
  exit 1
}
