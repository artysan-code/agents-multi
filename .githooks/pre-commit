#!/usr/bin/env bash
# pre-commit — enabled by `agents-multi install` (git config core.hooksPath .githooks).
#
#   1. runtime and credential files never enter the repository: only the staged files are looked at
#   2. secret patterns in the staged lines
#   3. scripts/check.sh and the tests, when a file that can break them is staged; the suite takes a
#      few seconds and reads the fixtures' manifests, so a profile change that breaks a test is
#      caught here and not in CI
#
# The full gate (secret scan of the history, site build) runs before a push: .githooks/pre-push.
# Deliberate bypass: `git commit --no-verify`.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
red() {
  printf '\033[31m✗ %s\033[0m\n' "$*"
  fail=1
}

# 1. runtime state and credentials
while IFS= read -r f; do
  case "$f" in
    *.credentials.json* | */.claude.json* | *claude.json.bak* | *.claude.json | */sessions/* | */projects/* | *.jsonl)
      red "runtime or credential file staged: $f"
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. secret patterns in the added lines
PAT='sk-ant-[A-Za-z0-9_-]{10,}|"(accessToken|refreshToken|oauthAccount|api[_-]?key|apiKey|token)"\s*:\s*"[^"]{8,}|ghp_[A-Za-z0-9]{20,}|glpat-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'
ALLOW='anthropic-apt\.asc|tests/|\.githooks/'
while IFS= read -r line; do
  file="${line%%:*}"
  [[ "$file" =~ $ALLOW ]] && continue
  red "possible secret staged: $line"
done < <(git diff --cached -U0 --diff-filter=ACMR | awk '/^\+\+\+ b\//{f=substr($0,7)} /^\+[^+]/{print f": "substr($0,2)}' | grep -E "$PAT" | cut -c1-160)

# 3. check and tests, skipped for commits that touch neither code nor what the tests read
if git diff --cached --name-only | grep -qE '\.(ts|js|sh|py|json|md|css|html)$|^bin/|^\.githooks/|^shared/|^config\.example/|^desktop/|^apps/'; then
  if command -v deno >/dev/null; then
    log=$(mktemp)
    bash scripts/check.sh >"$log" 2>&1 || {
      red "scripts/check.sh failed:"
      tail -20 "$log"
    }
    deno task --quiet test >"$log" 2>&1 || {
      red "deno task test failed:"
      tail -20 "$log"
    }
    rm -f "$log"
  else
    printf '\033[33m! deno not installed: check and tests skipped\033[0m\n'
  fi
fi

if ((fail)); then
  echo "commit blocked by the pre-commit hook (bypass: git commit --no-verify)" >&2
  exit 1
fi
