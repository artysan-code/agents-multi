#!/usr/bin/env bash
# pre-commit di claude-multi — attivato da `claude-multi install` (git config core.hooksPath .githooks).
#
#   1. guard segreti: il repo contiene la config viva di due account Anthropic; un token committato
#      e pushato su Forgejo è un incidente. Si guarda SOLO lo staged (diff --cached), non il working tree.
#   2. deno task check: type-check della CLI e sintassi degli script bash.
#   3. deno task test: la suite gira in ~250 ms e legge i manifest veri, quindi coglie i casi in cui
#      una modifica ai profili rompe un test che dà per scontati i nomi. Senza questo passo un
#      commit rosso passa: è successo, rinominando un profilo.
#
# Bypass consapevole: `git commit --no-verify` (e sappi perché).
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0
red() { printf '\033[31m✗ %s\033[0m\n' "$*"; fail=1; }

# --- 1. file che non devono MAI entrare (stato runtime, credenziali)
while IFS= read -r f; do
  case "$f" in
    *.credentials.json*|*/.claude.json*|*claude.json.bak*|*.claude.json|*/sessions/*|*/projects/*|*.jsonl)
      red "file di stato/credenziali in staging: $f" ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# --- 2. pattern di segreti nelle righe aggiunte
PAT='sk-ant-[A-Za-z0-9_-]{10,}|"(accessToken|refreshToken|oauthAccount|api[_-]?key|apiKey|token)"\s*:\s*"[^"]{8,}|ghp_[A-Za-z0-9]{20,}|glpat-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}'
ALLOW='anthropic-apt\.asc|tests/|\.githooks/pre-commit'
while IFS= read -r line; do
  file="${line%%:*}"
  [[ "$file" =~ $ALLOW ]] && continue
  red "possibile segreto in staging → $line"
done < <(git diff --cached -U0 --diff-filter=ACMR | awk '/^\+\+\+ b\//{f=substr($0,7)} /^\+[^+]/{print f": "substr($0,2)}' | grep -E "$PAT" | cut -c1-160)

# --- 3. check (solo se sono cambiati file rilevanti: veloce sui commit di sole docs)
# I manifest e il registry contano quanto il codice: cambiare un profilo può rompere un test.
if git diff --cached --name-only | grep -qE '\.(ts|sh)$|^bin/|^deno\.json$|^profiles/|^shared/mcp/|^desktop/'; then
  if command -v deno >/dev/null; then
    deno task --quiet check >/tmp/claude-multi-precommit.log 2>&1 || { red "deno task check fallito:"; tail -20 /tmp/claude-multi-precommit.log; }
    deno task --quiet test >/tmp/claude-multi-precommit-test.log 2>&1 || { red "deno task test fallito:"; tail -20 /tmp/claude-multi-precommit-test.log; }
  else
    printf '\033[33m! deno assente: check e test saltati\033[0m\n'
  fi
fi

if (( fail )); then
  echo "commit bloccato dal pre-commit di claude-multi (bypass: git commit --no-verify)" >&2
  exit 1
fi
